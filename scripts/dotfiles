#!/usr/bin/env bash
# dotfiles — small interface for the layered, stow-based dotfiles repo.
#
# Deliberately tiny: it manages the repo <-> system relationship and nothing
# that a normal command already does well. Main commands:
#   status   one aggregated dashboard (machine, repo, layers, drift, sync, recovery)
#   update   pull, re-stow, install missing packages (the daily maintenance verb)
#   apply    re-stow layers only (after editing configs locally)
#   wallpaper rotate randomize wallpaper from repo/local folders
#   autostart audit and manage login/startup items
set -euo pipefail

if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  for b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    if [ -x "$b" ] && [ -z "${DOTFILES_BASH_REEXEC:-}" ]; then
      DOTFILES_BASH_REEXEC=1 exec "$b" "$0" "$@"
    fi
  done
  printf 'err this tool needs bash >= 4; on macOS run: brew install bash\n' >&2
  exit 1
fi

_self="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck disable=SC1091
. "$_self/lib/common.sh"
# shellcheck disable=SC1091
. "$_self/lib/stow.sh"
# shellcheck disable=SC1091
. "$_self/lib/packages.sh"
# shellcheck disable=SC1091
. "$_self/lib/autostart.sh"

ensure_homebrew_path() {
  [[ "$(detect_os)" == "macos" ]] || return 0
  command -v brew >/dev/null 2>&1 && return 0
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
}

ensure_homebrew_path

usage() {
  cat <<'EOF'
dotfiles — layered stow-based dotfiles manager

Usage:
  dotfiles status            One dashboard: machine, repo, layers, package drift,
                             sync tools, recovery pack.
  dotfiles update            Pull, re-stow all layers, install missing packages.
  dotfiles update --dry-run  Show what update would do, change nothing.
  dotfiles apply             Re-stow layers only (after editing configs).
  dotfiles apply --dry-run   Show what stow would do, change nothing.
  dotfiles doctor            Lightweight bootstrap health checks.
  dotfiles commands list     List discoverable shortcuts, aliases, layouts, commands.
  dotfiles commands search   Search discoverable dotfiles entries.
  dotfiles commands doctor   Validate the discovery registry.
  dotfiles wallpaper rotate  Rotate wallpaper now.
  dotfiles wallpaper status  Show wallpaper rotation state.
  dotfiles screen off        Turn Omarchy displays off now.
  dotfiles screen on         Turn Omarchy displays back on.
  dotfiles oled on|off|status
                              Toggle fornax OLED idle protection.
  dotfiles tailscale-policy   Manage trusted-network Tailscale automation.
  dotfiles recovery setup     Configure AGE + Gmail app-password recovery email.
  dotfiles recovery send      Build, verify, and email an encrypted recovery pack.
  dotfiles git setup-ssh     Guided GitHub SSH setup; prompts before changes.
  dotfiles autostart status  Audit login/startup items.
  dotfiles autostart help    Show autostart subcommands.

Layers apply in order: global -> os-<os> -> profile-<hostname>-<os>
Edit configs under stow/<layer>/<package>/ then run `dotfiles apply`.
EOF
}

# --- apply ---------------------------------------------------------------
cmd_apply() {
  local extra=()
  [[ "${1:-}" == "--dry-run" ]] && extra=(--no --verbose)
  info "machine: $(detect_hostname) ($(detect_os)); profile: $(active_profile)"
  if [[ ${#extra[@]} -gt 0 ]]; then
    apply_all_layers "${extra[@]}" || warn "dry-run found stow conflicts (nothing changed)"
  else
    apply_all_layers
  fi
  refresh_after_apply "$([[ ${#extra[@]} -gt 0 ]] && printf 1 || printf 0)"
  [[ ${#extra[@]} -eq 0 ]] && ok "layers applied"
}

install_missing_packages() {
  local dry="$1"
  case "$(detect_os)" in
    omarchy) install_missing_omarchy_packages "$dry" ;;
    macos) install_missing_macos_packages "$dry" ;;
    *) install_missing_native_packages "$dry" ;;
  esac
}

# Two-phase like omarchy's pacman-then-AUR: formulae first, casks second.
# Never upgrades, never uninstalls, never --force.
install_missing_macos_packages() {
  local dry="$1" p missing_brew=() missing_cask=() failed=0
  if ! command -v brew >/dev/null 2>&1; then
    warn "Homebrew is required on macOS; install it from https://brew.sh"
    return 1
  fi
  validate_macos_package_declarations || return 1

  info "Checking brew formulae"
  while read -r p; do
    [[ -z "$p" ]] && continue
    _pkg_installed "$p" || missing_brew+=("$p")
  done < <(desired_brew_packages)
  if [[ ${#missing_brew[@]} -eq 0 ]]; then
    ok "all brew formulae installed"
  else
    printf '  missing formulae: %s\n' "${missing_brew[*]}"
    if [[ "$dry" -eq 1 ]]; then
      dim "  would run: brew install ${missing_brew[*]}"
    elif confirm "Install ${#missing_brew[@]} missing formula(e)?"; then
      _brew_install_or_hint "" "${missing_brew[@]}" || failed=1
    fi
  fi

  info "Checking brew casks"
  while read -r p; do
    [[ -z "$p" ]] && continue
    _pkg_installed "$p" || missing_cask+=("$p")
  done < <(desired_cask_packages)
  if [[ ${#missing_cask[@]} -eq 0 ]]; then
    ok "all brew casks installed"
  else
    printf '  missing casks: %s\n' "${missing_cask[*]}"
    if [[ "$dry" -eq 1 ]]; then
      dim "  would run: brew install --cask ${missing_cask[*]}"
    elif ! have_tty; then
      warn "cask installs skipped: no TTY (cask installers may need sudo)"
      warn "run later: brew install --cask ${missing_cask[*]}"
    elif confirm "Install ${#missing_cask[@]} missing cask(s)?"; then
      _brew_install_or_hint --cask "${missing_cask[@]}" || failed=1
    fi
  fi

  install_missing_macos_mas_apps "$dry" || failed=1
  return "$failed"
}

# Mac App Store apps from mas.txt (one numeric id per line, name in a
# trailing comment). mas needs a signed-in App Store account; failures warn
# and are retried on the next update.
install_missing_macos_mas_apps() {
  local dry="$1" id installed missing=()
  local ids=()
  while read -r id; do
    [[ -z "$id" ]] && continue
    ids+=("$id")
  done < <(desired_mas_packages)
  [[ ${#ids[@]} -gt 0 ]] || return 0
  info "Checking App Store apps"
  if ! command -v mas >/dev/null 2>&1; then
    warn "mas not installed yet; rerun dotfiles update after brew installs it"
    return 0
  fi
  installed="$(mas list 2>/dev/null | awk '{print $1}')"
  for id in "${ids[@]}"; do
    grep -Fxq "$id" <<<"$installed" || missing+=("$id")
  done
  if [[ ${#missing[@]} -eq 0 ]]; then
    ok "all App Store apps installed"
    return 0
  fi
  printf '  missing App Store app id(s): %s\n' "${missing[*]}"
  if [[ "$dry" -eq 1 ]]; then
    dim "  would run: mas install ${missing[*]}"
    return 0
  fi
  if ! have_tty; then
    warn "App Store installs skipped: no TTY"
    warn "run later: mas install ${missing[*]}"
    return 0
  fi
  if confirm "Install ${#missing[@]} App Store app(s)?"; then
    if mas install "${missing[@]}"; then
      ok "App Store apps installed"
    else
      warn "mas install failed; sign into the App Store app, then rerun dotfiles update"
      return 1
    fi
  fi
}

_brew_install_or_hint() {
  local kind="$1" status=0 n taps=""
  shift
  local args=(install)
  [[ "$kind" == "--cask" ]] && args+=(--cask)
  info "Installing with brew: $*"
  set +e
  if have_tty; then
    brew "${args[@]}" "$@" </dev/tty
  else
    brew "${args[@]}" "$@"
  fi
  status=$?
  set -e
  _brew_installed_names=""  # invalidate the installed-names cache
  if [[ "$status" -ne 0 ]]; then
    warn "brew install failed (exit $status)"
    if ! _macos_user_is_admin; then
      warn "$USER is not an admin account; installs into /Applications (and privileged installers like Parallels) cannot complete"
      warn "from an admin account: System Settings -> Users & Groups -> $USER -> Allow this user to administer this computer"
      warn "then rerun: dotfiles update"
    fi
    if ! _macos_brew_prefix_writable; then
      warn "Homebrew prefix $(_macos_brew_prefix) is not writable by $USER (owned by another account)"
      warn "single-account Mac: sudo chown -R $USER $(_macos_brew_prefix)"
      warn "shared Mac (several accounts use brew; chown would break the other account):"
      warn "  sudo chgrp -R admin $(_macos_brew_prefix) && sudo chmod -R g+w $(_macos_brew_prefix)"
      warn "then rerun: dotfiles update"
    fi
    for n in "$@"; do
      case "$n" in */*/*) taps="$taps ${n%/*}" ;; esac
    done
    if [[ -n "$taps" ]]; then
      warn "if brew reported an untrusted tap, declared taps are trusted inputs; run:"
      warn "  brew trust$taps"
      warn "then rerun: dotfiles update"
    fi
    if [[ "$kind" == "--cask" ]]; then
      warn "if a cask failed over an existing app, adopt it manually:"
      warn "  brew install --cask --adopt <name>"
    fi
    return 1
  fi
}

install_missing_native_packages() {
  local dry="$1" mgr missing=() p failed=0 os
  os="$(detect_os)"
  mgr="$(pkg_manager)"
  if [[ -z "$mgr" ]]; then
    warn "no known package manager for this OS, skipping"
    return 0
  fi
  while read -r p; do
    [[ -z "$p" ]] && continue
    _pkg_installed "$p" || missing+=("$p")
  done < <(desired_packages)
  if [[ ${#missing[@]} -eq 0 ]]; then
    ok "all declared packages installed"
  else
    printf '  missing: %s\n' "${missing[*]}"
    if [[ "$dry" -eq 1 ]]; then
      dim "  would run: $mgr ${missing[*]}"
    elif confirm "Install ${#missing[@]} missing package(s)?"; then
      # shellcheck disable=SC2086
      if ! $mgr "${missing[@]}"; then
        case "$os" in
          debian|ubuntu) install_apt_packages_individually "$mgr" "${missing[@]}" || failed=1 ;;
          *) return 1 ;;
        esac
      fi
    fi
  fi

  case "$os" in
    debian|ubuntu) install_or_update_debian_yazi "$dry" || failed=1 ;;
  esac

  return "$failed"
}

# apt aborts the whole transaction when any requested name is unavailable
# (eza needs Debian 13+/Ubuntu 24.04+; third-party-repo packages are missing
# on stock installs), so retry one at a time and report what was skipped.
install_apt_packages_individually() {
  local mgr="$1" p unavailable=()
  shift
  warn "batch install failed; retrying packages one at a time"
  for p in "$@"; do
    # shellcheck disable=SC2086
    $mgr "$p" || unavailable+=("$p")
  done
  if [[ ${#unavailable[@]} -gt 0 ]]; then
    warn "not installable on this release/repo set (skipped): ${unavailable[*]}"
    return 1
  fi
  ok "all packages installed after per-package retry"
}

install_or_update_debian_yazi() {
  local dry="$1" arch asset_arch asset_name installed_version tag latest_version
  local tmpdir release_json deb_file download_url digest expected_sha actual_sha

  arch="$(dpkg --print-architecture 2>/dev/null || uname -m)"
  case "$arch" in
    arm64|aarch64) asset_arch="aarch64" ;;
    amd64|x86_64) asset_arch="x86_64" ;;
    *) warn "Yazi official .deb is not managed for this Debian architecture: $arch"; return 0 ;;
  esac
  asset_name="yazi-${asset_arch}-unknown-linux-gnu.deb"
  installed_version="$(dpkg-query -W -f='${Version}' yazi 2>/dev/null || true)"

  if [[ "$dry" -eq 1 ]]; then
    if [[ -n "$installed_version" ]]; then
      dim "  would check latest stable Yazi release and update official .deb if newer than $installed_version"
    else
      dim "  would install Yazi from latest stable official GitHub .deb: $asset_name"
    fi
    return 0
  fi

  if ! command -v curl >/dev/null 2>&1; then
    warn "curl is required to install/update Yazi from the official GitHub .deb; rerun dotfiles update after apt packages install"
    return 1
  fi
  if ! command -v jq >/dev/null 2>&1; then
    warn "jq is required to verify the latest Yazi release metadata; rerun dotfiles update after apt packages install"
    return 1
  fi
  if ! command -v sha256sum >/dev/null 2>&1; then
    warn "sha256sum is required to verify the Yazi .deb download"
    return 1
  fi

  tmpdir="$(mktemp -d)"
  release_json="$tmpdir/yazi-release.json"
  deb_file="$tmpdir/$asset_name"

  if ! curl -fsSL --retry 3 --connect-timeout 10 \
    https://api.github.com/repos/sxyazi/yazi/releases/latest \
    -o "$release_json"; then
    rm -rf "$tmpdir"
    warn "could not check latest Yazi release; leaving installed Yazi unchanged"
    return 1
  fi

  tag="$(jq -r '.tag_name // empty' "$release_json")"
  if [[ ! "$tag" =~ ^v[0-9]+([.][0-9]+)*$ ]]; then
    rm -rf "$tmpdir"
    warn "unexpected Yazi release tag from GitHub: ${tag:-missing}"
    return 1
  fi
  latest_version="${tag#v}"

  if [[ -n "$installed_version" ]] && dpkg --compare-versions "$installed_version" ge "$latest_version"; then
    rm -rf "$tmpdir"
    ok "Yazi official .deb current: $installed_version"
    return 0
  fi

  download_url="$(jq -r --arg asset "$asset_name" '.assets[] | select(.name == $asset) | .browser_download_url' "$release_json")"
  digest="$(jq -r --arg asset "$asset_name" '.assets[] | select(.name == $asset) | .digest // empty' "$release_json")"
  if [[ -z "$download_url" ]]; then
    rm -rf "$tmpdir"
    warn "latest Yazi release does not include expected asset: $asset_name"
    return 1
  fi
  if [[ ! "$digest" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    rm -rf "$tmpdir"
    warn "latest Yazi release metadata did not include a usable sha256 digest for $asset_name"
    return 1
  fi

  info "Installing Yazi $tag from official GitHub .deb"
  if ! curl -fsSL --retry 3 --connect-timeout 10 "$download_url" -o "$deb_file"; then
    rm -rf "$tmpdir"
    warn "failed to download Yazi .deb: $download_url"
    return 1
  fi

  expected_sha="${digest#sha256:}"
  actual_sha="$(sha256sum "$deb_file" | awk '{print $1}')"
  if [[ "$actual_sha" != "$expected_sha" ]]; then
    rm -rf "$tmpdir"
    warn "Yazi .deb sha256 mismatch; refusing to install"
    return 1
  fi

  if ! sudo apt-get install -y "$deb_file"; then
    rm -rf "$tmpdir"
    warn "failed to install Yazi official .deb"
    return 1
  fi

  rm -rf "$tmpdir"
  ok "Yazi installed/updated to $latest_version"
}

install_missing_omarchy_packages() {
  local dry="$1" missing_pacman=() declared_aur=() missing_aur=() p aur_mgr

  validate_package_declarations || return 1

  info "Checking pacman profile packages"
  while read -r p; do
    [[ -z "$p" ]] && continue
    _pkg_installed "$p" || missing_pacman+=("$p")
  done < <(desired_pacman_packages)
  if [[ ${#missing_pacman[@]} -eq 0 ]]; then
    ok "all pacman profile packages installed"
  else
    printf '  missing pacman: %s\n' "${missing_pacman[*]}"
    if [[ "$dry" -eq 1 ]]; then
      dim "  would run: sudo pacman -S --needed ${missing_pacman[*]}"
    elif confirm "Install ${#missing_pacman[@]} missing pacman package(s)?"; then
      info "Installing pacman packages: ${missing_pacman[*]}"
      local pacman_args=(-S --needed)
      [[ "${DOTFILES_ASSUME_YES:-0}" == "1" ]] && pacman_args+=(--noconfirm)
      if have_tty; then
        # shellcheck disable=SC2024
        if ! sudo pacman "${pacman_args[@]}" "${missing_pacman[@]}" </dev/tty; then
          warn "pacman failed installing profile packages: ${missing_pacman[*]}"
          return 1
        fi
      else
        if ! sudo pacman "${pacman_args[@]}" "${missing_pacman[@]}"; then
          warn "pacman failed installing profile packages: ${missing_pacman[*]}"
          return 1
        fi
      fi
    fi
  fi

  info "Checking AUR profile packages"
  while read -r p; do
    [[ -z "$p" ]] && continue
    declared_aur+=("$p")
    _pkg_installed "$p" || missing_aur+=("$p")
  done < <(desired_aur_packages)
  if [[ ${#declared_aur[@]} -eq 0 ]]; then
    ok "no AUR profile packages declared"
    return 0
  fi

  ensure_paru_available "$dry" "${declared_aur[@]}" || return 1
  if [[ ${#missing_aur[@]} -eq 0 ]]; then
    ok "all AUR profile packages installed"
    return 0
  fi

  aur_mgr="$(aur_pkg_manager)"
  [[ "$dry" -eq 1 && -z "$aur_mgr" ]] && aur_mgr="paru -S --needed --noconfirm --skipreview"
  if [[ -z "$aur_mgr" ]]; then
    warn "AUR packages are declared but paru is not installed: ${missing_aur[*]}"
    return 1
  fi
  printf '  missing AUR: %s\n' "${missing_aur[*]}"
  if [[ "$dry" -eq 1 ]]; then
    dim "  would run: $aur_mgr ${missing_aur[*]}"
  elif ! have_tty; then
    warn "AUR installs require a TTY so paru cannot silently choose provider defaults"
    return 1
  else
    info "Installing AUR packages with paru: ${missing_aur[*]}"
    info "Using non-interactive trusted profile mode: --noconfirm --skipreview"
    # shellcheck disable=SC2086
    if ! $aur_mgr "${missing_aur[@]}" </dev/tty; then
      warn "paru failed installing AUR packages: ${missing_aur[*]}"
      return 1
    fi
    for p in "${missing_aur[@]}"; do
      if _pkg_installed "$p"; then
        ok "installed AUR package: $p"
      else
        warn "AUR package install completed but package is still missing: $p"
        return 1
      fi
    done
  fi
}

# --- update --------------------------------------------------------------
cmd_update() {
  local dry=0
  local stow_failed=0
  [[ "${1:-}" == "--dry-run" ]] && dry=1

  info "Update plan for $(detect_hostname) ($(detect_os)); profile: $(active_profile):"
  if [[ "$(detect_os)" == "omarchy" ]]; then
    printf '  1. git pull --ff-only\n  2. install pacman profile packages\n  3. install paru/AUR profile packages\n  4. re-stow layers (conflict wizard; never silently overwritten)\n  5. targeted desktop/system refreshes\n'
  elif [[ "$(detect_os)" == "macos" ]]; then
    printf '  1. git pull --ff-only\n  2. install brew formulae\n  3. install brew casks + App Store apps\n  4. re-stow layers (conflict wizard; never silently overwritten)\n  5. targeted refreshes\n'
  else
    printf '  1. git pull --ff-only\n  2. install missing packages\n  3. re-stow layers (conflict wizard; never silently overwritten)\n  4. targeted system refreshes\n'
  fi
  if [[ $dry -eq 1 ]]; then
    dim "(dry-run: nothing will change)"
  elif ! confirm "Proceed?"; then
    warn "aborted"; return 0
  fi

  # 1. pull
  info "Pulling repo"
  if [[ $dry -eq 1 ]]; then
    git -C "$DOTFILES_DIR" fetch --dry-run 2>&1 | sed 's/^/  /' || true
  else
    if ! update_repo_safely; then
      return 1
    fi
  fi

  # 2. packages before stow; fresh bootstrap needs stow installed first.
  # Package installs are best-effort: a failed brew install (permissions,
  # network, one bad cask) must not abort stow/defaults/service refreshes.
  info "Checking profile packages"
  local pkg_failed=0
  if ! install_missing_packages "$dry"; then
    pkg_failed=1
    warn "package installs failed; continuing with stow and refreshes"
  fi

  # 3. re-stow with friendly conflict handling.
  info "Re-stowing layers"
  if [[ $dry -eq 1 ]]; then
    if ! apply_all_layers --no --verbose; then
      stow_failed=1
      warn "stow reported conflicts; package check will still run"
    fi
  else
    if ! apply_all_layers --restow; then
      stow_failed=1
      warn "stow reported conflicts; package check will still run"
    fi
  fi

  if [[ $stow_failed -eq 1 ]]; then
    warn "update completed with stow conflicts"
    return 1
  fi

  configure_declared_services "$dry"
  refresh_after_apply "$dry"

  if [[ $pkg_failed -eq 1 ]]; then
    warn "update finished, but some packages did not install; fix the package error above and rerun dotfiles update"
  elif [[ $dry -eq 0 ]]; then
    ok "update complete"
  fi
  [[ $dry -eq 0 ]] && print_next_steps
  return 0
}

refresh_after_apply() {
  local dry="$1" needs_manual=()

  info "Refreshing changed configuration"

  refresh_systemd_daemons "$dry"
  configure_wallpaper_rotation "$dry"
  refresh_desktop_caches "$dry"
  refresh_shell_caches "$dry"

  if [[ "$(detect_os)" == "omarchy" ]]; then
    refresh_omarchy_session "$dry" needs_manual
  fi
  # lan-mouse only reads its peer config at startup.
  if [[ "$(detect_os)" == "macos" ]] && pgrep -x lan-mouse >/dev/null 2>&1 && _macos_dotfiles_launchagent_loaded lanmouse; then
    run_refresh_cmd "$dry" "lan-mouse restarted" launchctl kickstart -k "gui/$(id -u)/com.dotfiles.lanmouse" || true
  fi
  if [[ "$(detect_os)" == "macos" ]] && _macos_dotfiles_launchagent_loaded clipboard-notify; then
    run_refresh_cmd "$dry" "clipboard notification watcher restarted" launchctl kickstart -k "gui/$(id -u)/com.dotfiles.clipboard-notify" || true
  fi

  detect_manual_refreshes needs_manual
  if [[ ${#needs_manual[@]} -gt 0 ]]; then
    warn "manual refresh still needed: ${needs_manual[*]}"
  fi
}

run_refresh_cmd() {
  local dry="$1" label="$2"
  shift 2
  if [[ "$dry" -eq 1 ]]; then
    dim "  would run: $*"
    return 0
  fi
  if "$@" >/dev/null 2>&1; then
    ok "$label"
  else
    warn "refresh failed: $label"
    return 1
  fi
}

systemd_user_ready() {
  command -v systemctl >/dev/null 2>&1 || return 1
  systemctl --user show-environment >/dev/null 2>&1
}

systemd_user_unit_exists() {
  local unit="$1"
  systemd_user_ready || return 1
  systemctl --user list-unit-files "$unit" --no-legend 2>/dev/null | grep -q "^$unit"
}

systemd_user_unit_active() {
  local unit="$1"
  systemd_user_ready || return 1
  systemctl --user is-active --quiet "$unit" 2>/dev/null
}

refresh_systemd_daemons() {
  local dry="$1"
  command -v systemctl >/dev/null 2>&1 || return 0

  if [[ -d "$HOME/.config/systemd/user" ]] && systemd_user_ready; then
    run_refresh_cmd "$dry" "user systemd daemon reloaded" systemctl --user daemon-reload || true
  elif [[ -d "$HOME/.config/systemd/user" ]]; then
    warn "user systemd config exists but user manager is not reachable; log in again if user units do not appear"
  fi
}

refresh_desktop_caches() {
  local dry="$1" icon_dir font_dirs=()
  # macOS owns its font/app caches; the freedesktop tooling below may exist
  # via brew deps but must not be run against ~/Library conventions.
  [[ "$(uname -s)" == "Darwin" ]] && return 0

  if command -v fc-cache >/dev/null 2>&1 && [[ -d "$HOME/.local/share/fonts" || -d "$HOME/.fonts" ]]; then
    [[ -d "$HOME/.local/share/fonts" ]] && font_dirs+=("$HOME/.local/share/fonts")
    [[ -d "$HOME/.fonts" ]] && font_dirs+=("$HOME/.fonts")
    run_refresh_cmd "$dry" "font cache refreshed" fc-cache -f "${font_dirs[@]}" || true
  fi
  if command -v update-desktop-database >/dev/null 2>&1 && [[ -d "$HOME/.local/share/applications" ]]; then
    run_refresh_cmd "$dry" "desktop database refreshed" update-desktop-database "$HOME/.local/share/applications" || true
  fi
  if command -v update-mime-database >/dev/null 2>&1 && [[ -d "$HOME/.local/share/mime" ]]; then
    run_refresh_cmd "$dry" "MIME database refreshed" update-mime-database "$HOME/.local/share/mime" || true
  fi
  if command -v gtk-update-icon-cache >/dev/null 2>&1 && [[ -d "$HOME/.local/share/icons" ]]; then
    for icon_dir in "$HOME/.local/share/icons"/*; do
      [[ -f "$icon_dir/index.theme" ]] || continue
      run_refresh_cmd "$dry" "icon cache refreshed: $(basename "$icon_dir")" gtk-update-icon-cache -q -t -f "$icon_dir" || true
    done
  fi
}

refresh_shell_caches() {
  local dry="$1"
  if command -v zsh >/dev/null 2>&1 && [[ -f "$HOME/.zshrc" ]]; then
    if [[ "$dry" -eq 1 ]]; then
      dim "  would refresh zsh completion dump"
    else
      rm -f "$HOME"/.zcompdump* 2>/dev/null || true
      ok "zsh completion cache cleared"
    fi
  fi
}

refresh_omarchy_session() {
  local dry="$1" needs_manual_ref="$2"

  if command -v hyprctl >/dev/null 2>&1 && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    run_refresh_cmd "$dry" "Hyprland config reloaded" hyprctl reload || true
    if [[ "$dry" -eq 0 ]]; then
      hyprctl configerrors || true
    fi
  fi

  if command -v omarchy >/dev/null 2>&1 && pgrep -x quickshell >/dev/null 2>&1; then
    run_refresh_cmd "$dry" "Omarchy shell restarted" omarchy restart shell || true
  elif systemd_user_unit_active waybar.service; then
    run_refresh_cmd "$dry" "waybar user service restarted" systemctl --user restart waybar.service || true
  fi

  if command -v hypridle >/dev/null 2>&1 && [[ -f "$HOME/.config/hypr/hypridle.conf" ]]; then
    if [[ "$dry" -eq 1 ]]; then
      dim "  would restart profile Hypridle policy"
    else
      mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/indicators"
      : >"${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/indicators/stay-awake"
      pkill -x hypridle >/dev/null 2>&1 || true
      setsid -f hypridle >/dev/null 2>&1
      ok "profile Hypridle policy restarted"
    fi
  fi

  if systemd_user_unit_active hyprpaper.service; then
    run_refresh_cmd "$dry" "hyprpaper user service restarted" systemctl --user restart hyprpaper.service || true
  elif pgrep -x hyprpaper >/dev/null 2>&1; then
    warn "hyprpaper is running without a known user service; leave it running to avoid disrupting wallpaper state"
    eval "$needs_manual_ref+=(hyprpaper)"
  fi

  for unit in xdg-desktop-portal.service xdg-desktop-portal-hyprland.service lan-mouse.service dotfiles-clipboard-notify.service; do
    if systemd_user_unit_active "$unit"; then
      run_refresh_cmd "$dry" "$unit restarted" systemctl --user try-restart "$unit" || true
    fi
  done

  if pgrep -x mako >/dev/null 2>&1 && ! systemd_user_unit_exists mako.service; then
    warn "mako is running without a known user service; not killing notification daemon"
    eval "$needs_manual_ref+=(mako)"
  fi
}

detect_manual_refreshes() {
  local needs_manual_ref="$1"
  if [[ -f /run/reboot-required ]]; then
    eval "$needs_manual_ref+=(reboot)"
  fi
}

configure_declared_services() {
  local dry="$1"
  if [[ "$(detect_os)" == "macos" ]]; then
    configure_macos_declared_services "$dry"
    return 0
  fi
  [[ "$(detect_os)" == "omarchy" ]] || return 0
  configure_omarchy_lanmouse "$dry" || true
  configure_omarchy_kdeconnect "$dry" || true
  configure_omarchy_clipboard_notify "$dry" || true
  configure_omarchy_llm_host "$dry" || true
  package_declared tailscale || return 0
  command -v systemctl >/dev/null 2>&1 || return 0
  command -v tailscaled >/dev/null 2>&1 || command -v tailscale >/dev/null 2>&1 || return 0
  if systemctl is-active --quiet tailscaled.service 2>/dev/null; then
    ok "tailscaled daemon running"
    return 0
  fi
  if [[ "$dry" -eq 1 ]]; then
    dim "  would run: sudo systemctl enable --now tailscaled.service"
  elif confirm "Enable and start tailscaled.service?"; then
    sudo systemctl enable --now tailscaled.service
  else
    warn "tailscaled.service not started; run: sudo systemctl enable --now tailscaled.service"
  fi
}

# Lan Mouse peers (docs/kvm-sharing.md): the user unit ships in the
# os-omarchy stow layer, but only machines whose profile stows a peer config
# get the binary installed and the service enabled, so unpaired machines stay
# silent. The binary is the pinned upstream release, NOT the pacman package:
# Omarchy's package snapshot can lag on a pre-DTLS protocol version that
# cannot interoperate with 0.11+ peers, and peers must match.
configure_omarchy_lanmouse() {
  local dry="$1"
  [[ -e "$HOME/.config/lan-mouse/config.toml" ]] || return 0
  _omarchy_lanmouse_install_bin "$dry" || return 0
  if ! systemd_user_ready; then
    warn "user systemd manager is not reachable; lan-mouse.service will be enabled on next update/login"
    return 0
  fi
  configure_omarchy_lanmouse_firewall "$dry"
  if systemd_user_unit_active lan-mouse.service && \
     [[ "$(_omarchy_lanmouse_installed_version)" == "$_LANMOUSE_VERSION" ]]; then
    ok "lan-mouse service running"
    return 0
  fi
  if [[ "$dry" -eq 1 ]]; then
    dim "  would run: systemctl --user enable --now lan-mouse.service (and restart it)"
    return 0
  fi
  systemctl --user daemon-reload >/dev/null 2>&1 || true
  systemctl --user enable lan-mouse.service >/dev/null 2>&1 || true
  if systemctl --user restart lan-mouse.service >/dev/null 2>&1; then
    sleep 2
    if systemd_user_unit_active lan-mouse.service; then
      ok "lan-mouse service running"
    else
      warn "lan-mouse.service started but is not staying up; inspect: journalctl --user -u lan-mouse.service -n 20"
    fi
  else
    warn "failed to start lan-mouse.service; inspect: journalctl --user -u lan-mouse.service -n 20"
  fi
}

# KDE Connect (clipboard sync companion, docs/kvm-sharing.md): kdeconnectd is
# dbus-activated on KDE but does not start reliably under Hyprland, so the
# stowed user unit keeps it alive; discovery also needs its ufw ports open.
configure_omarchy_kdeconnect() {
  local dry="$1"
  package_declared kdeconnect || return 0
  if [[ ! -x /usr/bin/kdeconnectd ]]; then
    warn "kdeconnect is declared but not installed; run dotfiles update again after package install completes"
    return 0
  fi
  if ! systemd_user_ready; then
    warn "user systemd manager is not reachable; kdeconnectd.service will be enabled on next update/login"
    return 0
  fi
  configure_omarchy_kdeconnect_firewall "$dry"
  if systemd_user_unit_active kdeconnectd.service; then
    ok "kdeconnectd service running"
    return 0
  fi
  if [[ "$dry" -eq 1 ]]; then
    dim "  would run: systemctl --user enable --now kdeconnectd.service (and restart it)"
    return 0
  fi
  systemctl --user daemon-reload >/dev/null 2>&1 || true
  systemctl --user enable kdeconnectd.service >/dev/null 2>&1 || true
  if systemctl --user restart kdeconnectd.service >/dev/null 2>&1; then
    sleep 2
    if systemd_user_unit_active kdeconnectd.service; then
      ok "kdeconnectd service running"
    else
      warn "kdeconnectd.service started but is not staying up; inspect: journalctl --user -u kdeconnectd.service -n 20"
    fi
  else
    warn "failed to start kdeconnectd.service; inspect: journalctl --user -u kdeconnectd.service -n 20"
  fi
}

# KDE Connect discovery and transfers need 1714-1764 tcp+udp open for
# incoming traffic.
configure_omarchy_kdeconnect_firewall() {
  local dry="$1"
  _omarchy_ufw_offer "$dry" kdeconnect \
    "Allow incoming KDE Connect traffic (1714:1764 tcp+udp) through ufw?" \
    "sudo ufw allow 1714:1764/tcp comment 'kdeconnect' && sudo ufw allow 1714:1764/udp comment 'kdeconnect'" \
    "allow 1714:1764/tcp comment kdeconnect" \
    "allow 1714:1764/udp comment kdeconnect"
}

configure_omarchy_clipboard_notify() {
  local dry="$1"
  package_declared wl-clipboard || return 0
  package_declared libnotify || return 0
  if [[ ! -x "$HOME/.local/bin/dotfiles-clipboard-notify" ]]; then
    warn "clipboard notification script is not stowed yet; run dotfiles apply"
    return 0
  fi
  if ! command -v wl-paste >/dev/null 2>&1; then
    warn "wl-clipboard is declared but wl-paste is missing; run dotfiles update after packages install"
    return 0
  fi
  if ! command -v notify-send >/dev/null 2>&1; then
    warn "libnotify is declared but notify-send is missing; run dotfiles update after packages install"
    return 0
  fi
  if ! systemd_user_ready; then
    warn "user systemd manager is not reachable; dotfiles-clipboard-notify.service will be enabled on next update/login"
    return 0
  fi
  if systemd_user_unit_active dotfiles-clipboard-notify.service; then
    ok "clipboard notification service running"
    return 0
  fi
  if [[ "$dry" -eq 1 ]]; then
    dim "  would run: systemctl --user enable --now dotfiles-clipboard-notify.service (and restart it)"
    return 0
  fi
  systemctl --user daemon-reload >/dev/null 2>&1 || true
  systemctl --user enable dotfiles-clipboard-notify.service >/dev/null 2>&1 || true
  if systemctl --user restart dotfiles-clipboard-notify.service >/dev/null 2>&1; then
    sleep 1
    if systemd_user_unit_active dotfiles-clipboard-notify.service; then
      ok "clipboard notification service running"
    else
      warn "dotfiles-clipboard-notify.service started but is not staying up; inspect: journalctl --user -u dotfiles-clipboard-notify.service -n 20"
    fi
  else
    warn "failed to start dotfiles-clipboard-notify.service; inspect: journalctl --user -u dotfiles-clipboard-notify.service -n 20"
  fi
}

_omarchy_lanmouse_bin() { printf '%s/.local/share/dotfiles/bin/lan-mouse\n' "$HOME"; }

_omarchy_lanmouse_installed_version() {
  "$(_omarchy_lanmouse_bin)" --version 2>/dev/null | awk 'NR==1 {print $2}'
}

_omarchy_lanmouse_install_bin() {
  local dry="$1" arch asset sha url tmp bin
  bin="$(_omarchy_lanmouse_bin)"
  if [[ -x "$bin" && "$(_omarchy_lanmouse_installed_version)" == "$_LANMOUSE_VERSION" ]]; then
    ok "lan-mouse $_LANMOUSE_VERSION installed (dotfiles-pinned)"
    return 0
  fi
  arch="$(uname -m)"
  case "$arch" in
    x86_64) asset="lan-mouse-linux-x86_64"; sha="$_LANMOUSE_SHA256_LINUX_X86_64" ;;
    aarch64) asset="lan-mouse-linux-arm64"; sha="$_LANMOUSE_SHA256_LINUX_ARM64" ;;
    *) warn "unsupported Linux architecture for lan-mouse: $arch"; return 1 ;;
  esac
  url="https://github.com/feschber/lan-mouse/releases/download/v$_LANMOUSE_VERSION/$asset"
  if [[ "$dry" -eq 1 ]]; then
    dim "  would install lan-mouse $_LANMOUSE_VERSION to $bin from $url"
    return 0
  fi

  info "Installing lan-mouse $_LANMOUSE_VERSION ($asset)"
  tmp="$(mktemp -d)"
  if ! curl -fsSL -o "$tmp/$asset" "$url"; then
    warn "lan-mouse download failed: $url"
    rm -rf "$tmp"
    return 1
  fi
  if [[ "$(sha256sum "$tmp/$asset" | awk '{print $1}')" != "$sha" ]]; then
    warn "lan-mouse download failed checksum verification; not installing"
    rm -rf "$tmp"
    return 1
  fi
  chmod +x "$tmp/$asset"
  mkdir -p "$(dirname "$bin")"
  if ! mv -f "$tmp/$asset" "$bin"; then
    warn "could not install lan-mouse to $bin"
    rm -rf "$tmp"
    return 1
  fi
  rm -rf "$tmp"
  if [[ "$(_omarchy_lanmouse_installed_version)" == "$_LANMOUSE_VERSION" ]]; then
    ok "lan-mouse $_LANMOUSE_VERSION installed (dotfiles-pinned)"
  else
    warn "lan-mouse installed but version check failed; inspect $bin"
    return 1
  fi
}

# One-time ufw offers are tracked with a marker file instead of service
# state: coupling them to "service not yet active" meant a machine whose
# service came up first was never asked, leaving the port silently blocked.
_omarchy_ufw_marker() {
  printf '%s/dotfiles/ufw-%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}" "$1"
}

# _omarchy_ufw_offer <marker-name> <question> <manual-hint> <ufw-args>...
# Prompts once per machine (marker recorded for both yes and no) and applies
# each comma-separated ufw rule. No-op when ufw is missing or inactive.
_omarchy_ufw_offer() {
  local dry="$1" name="$2" question="$3" hint="$4" marker rule failed=0
  shift 4
  marker="$(_omarchy_ufw_marker "$name")"
  [[ -f "$marker" ]] && return 0
  command -v ufw >/dev/null 2>&1 || return 0
  systemctl is-active --quiet ufw.service 2>/dev/null || return 0
  if [[ "$dry" -eq 1 ]]; then
    dim "  would offer: $hint"
    return 0
  fi
  if confirm "$question"; then
    for rule in "$@"; do
      # shellcheck disable=SC2086
      sudo ufw $rule >/dev/null 2>&1 || failed=1
    done
    if [[ $failed -eq 0 ]]; then
      ok "ufw rules ensured ($name)"
    else
      warn "failed to add ufw rule(s); run: $hint"
      return 0
    fi
  else
    warn "declined; this machine stays unreachable for $name until: $hint"
  fi
  mkdir -p "$(dirname "$marker")"
  printf 'answered %s\n' "$(date +%Y-%m-%d)" >"$marker"
}

# Omarchy ships ufw enabled; a peer can only send input here once incoming
# DTLS on 4242/udp is allowed.
configure_omarchy_lanmouse_firewall() {
  local dry="$1"
  _omarchy_ufw_offer "$dry" lan-mouse \
    "Allow incoming lan-mouse traffic (4242/udp) through ufw?" \
    "sudo ufw allow 4242/udp comment 'lan-mouse'" \
    "allow 4242/udp comment lan-mouse"
}

configure_macos_declared_services() {
  local dry="$1"
  configure_macos_trusted_taps "$dry"
  package_declared_short tailscale && configure_macos_tailscale "$dry" || true
  configure_macos_ladomum_resolver "$dry" || true
  configure_macos_jetbrains_mono_font "$dry"
  package_declared_short dbus && configure_macos_dbus "$dry" || true
  package_declared_short borders && configure_macos_dotfiles_launchagent "$dry" borders || true
  package_declared_short linearmouse && configure_macos_dotfiles_launchagent "$dry" linearmouse LinearMouse /Applications/LinearMouse.app || true
  configure_macos_lanmouse "$dry" || true
  # The KDE Connect app does not reliably (re)spawn its discovery daemon, so
  # kdeconnectd is managed like the other dotfiles daemons.
  package_declared_short kde-connect && configure_macos_dotfiles_launchagent "$dry" kdeconnectd kdeconnectd "/Applications/KDE Connect.app" || true
  configure_macos_clipboard_notify "$dry" || true
  configure_macos_dock_defaults "$dry"
  configure_macos_finder_defaults "$dry"
  configure_macos_input_defaults "$dry"
  configure_macos_aerospace "$dry"
  configure_macos_desktop_apps "$dry"
}

configure_macos_trusted_taps() {
  local dry="$1" pkg tap taps=() trusted=()
  command -v brew >/dev/null 2>&1 || return 0
  while read -r pkg; do
    [[ -z "$pkg" ]] && continue
    case "$pkg" in
      */*/*)
        tap="${pkg%/*}"
        case " ${taps[*]} " in *" $tap "*) ;; *) taps+=("$tap") ;; esac
        ;;
    esac
  done < <({ desired_brew_packages; desired_cask_packages; })

  [[ ${#taps[@]} -gt 0 ]] || return 0
  if [[ "$dry" -eq 1 ]]; then
    dim "  would run: brew trust ${taps[*]}"
    return 0
  fi
  for tap in "${taps[@]}"; do
    if brew trust "$tap" >/dev/null 2>&1; then
      trusted+=("$tap")
    else
      warn "failed to trust declared brew tap: $tap"
    fi
  done
  [[ ${#trusted[@]} -eq 0 ]] || ok "trusted declared brew tap(s): ${trusted[*]}"
}

configure_macos_tailscale() {
  local dry="$1" tailscaled_cmd
  if [[ -d /Applications/Tailscale.app ]]; then
    warn "Tailscale.app is installed; remove it before enabling the Homebrew tailscaled daemon"
    warn "  delete /Applications/Tailscale.app, approve VPN profile removal, then rerun dotfiles update"
    return 0
  fi

  tailscaled_cmd="$(_macos_tailscaled_cmd)"
  if [[ -z "$tailscaled_cmd" ]]; then
    if [[ "$dry" -eq 1 ]]; then
      tailscaled_cmd="$(_macos_brew_prefix)/bin/tailscaled"
    else
      warn "tailscale formula is declared but tailscaled is not installed yet; rerun dotfiles update after brew finishes"
      return 0
    fi
  fi
  if [[ ! -x "$tailscaled_cmd" && "$dry" -ne 1 ]]; then
    warn "tailscale formula is declared but tailscaled is not installed yet; rerun dotfiles update after brew finishes"
    return 0
  fi
  if _macos_tailscale_daemon_installed; then
    if _macos_tailscale_daemon_running; then
      ok "Tailscale system daemon running"
    else
      warn "Tailscale system daemon installed but not running"
      warn "  run: sudo \"$tailscaled_cmd\" install-system-daemon"
    fi
    return 0
  fi

  if [[ "$dry" -eq 1 ]]; then
    dim "  would run: sudo \"$tailscaled_cmd\" install-system-daemon"
  elif ! have_tty; then
    warn "Tailscale system daemon install needs sudo from a TTY"
    warn "  run: sudo \"$tailscaled_cmd\" install-system-daemon"
  elif confirm "Install Tailscale system daemon?"; then
    if sudo "$tailscaled_cmd" install-system-daemon; then
      ok "Tailscale system daemon installed"
    else
      warn "failed to install Tailscale system daemon"
      warn "  run: sudo \"$tailscaled_cmd\" install-system-daemon"
    fi
  else
    warn "Tailscale system daemon not installed; run: sudo \"$tailscaled_cmd\" install-system-daemon"
  fi
}

configure_macos_ladomum_resolver() {
  local dry="$1" source_file target_file
  source_file="$(_macos_ladomum_resolver_source)"
  target_file="$(_macos_ladomum_resolver_target)"

  if [[ ! -r "$source_file" ]]; then
    warn "ladomum.com resolver source missing: $source_file"
    return 0
  fi
  if [[ -r "$target_file" ]] && cmp -s "$source_file" "$target_file"; then
    ok "ladomum.com resolver installed"
    return 0
  fi
  if [[ "$dry" -eq 1 ]]; then
    dim "  would install resolver: $target_file"
    return 0
  fi
  if ! have_tty; then
    warn "ladomum.com resolver install needs sudo from a TTY"
    warn "  run: sudo mkdir -p /etc/resolver && sudo install -m 0644 \"$source_file\" \"$target_file\""
    return 0
  fi
  if confirm "Install macOS resolver for ladomum.com?"; then
    if sudo mkdir -p /etc/resolver && sudo install -m 0644 "$source_file" "$target_file"; then
      dscacheutil -flushcache >/dev/null 2>&1 || true
      sudo killall -HUP mDNSResponder >/dev/null 2>&1 || true
      ok "ladomum.com resolver installed"
    else
      warn "failed to install ladomum.com resolver"
      warn "  run: sudo mkdir -p /etc/resolver && sudo install -m 0644 \"$source_file\" \"$target_file\""
    fi
  else
    warn "ladomum.com resolver not installed; run dotfiles update when ready"
  fi
}

configure_macos_dbus() {
  local dry="$1" uid source_plist target_plist
  uid="$(id -u)"
  source_plist="$HOME/.local/share/dotfiles/LaunchAgents/org.freedesktop.dbus-session.plist"
  if [[ ! -r "$source_plist" ]]; then
    source_plist="$DOTFILES_DIR/stow/os-macos/launchagents/.local/share/dotfiles/LaunchAgents/org.freedesktop.dbus-session.plist"
  fi
  target_plist="$HOME/Library/LaunchAgents/org.freedesktop.dbus-session.plist"

  if [[ ! -x /opt/homebrew/opt/dbus/bin/dbus-daemon ]]; then
    warn "dbus is declared but dbus-daemon is missing; run dotfiles update after package install completes"
    return 0
  fi
  if [[ ! -r "$source_plist" ]]; then
    warn "D-Bus LaunchAgent source missing: $source_plist"
    return 0
  fi
  if _macos_dbus_session_loaded; then
    ok "D-Bus session LaunchAgent loaded"
    return 0
  fi
  if [[ "$dry" -eq 1 ]]; then
    dim "  would install LaunchAgent: $target_plist"
    dim "  would run: launchctl bootstrap gui/$uid $target_plist"
    return 0
  fi

  mkdir -p "$HOME/Library/LaunchAgents"
  cp "$source_plist" "$target_plist"
  launchctl bootout "gui/$uid/org.freedesktop.dbus-session" >/dev/null 2>&1 || true
  launchctl bootout "gui/$uid" "$target_plist" >/dev/null 2>&1 || true
  if launchctl bootstrap "gui/$uid" "$target_plist" >/dev/null 2>&1; then
    if _macos_dbus_session_loaded; then
      ok "D-Bus session LaunchAgent loaded"
    else
      warn "D-Bus session LaunchAgent was installed but did not load"
    fi
  else
    warn "failed to load D-Bus session LaunchAgent: $target_plist"
  fi
}

configure_macos_clipboard_notify() {
  local dry="$1" script source_script target_plist uid
  script="$HOME/.local/bin/dotfiles-clipboard-notify"
  source_script="$DOTFILES_DIR/stow/global/scripts/.local/bin/dotfiles-clipboard-notify"
  target_plist="$HOME/Library/LaunchAgents/com.dotfiles.clipboard-notify.plist"
  uid="$(id -u)"

  if [[ "$dry" -eq 1 && ! -e "$script" && -x "$source_script" ]]; then
    dim "  would stop Homebrew service: clipboard-notify"
    dim "  would install LaunchAgent: $target_plist"
    dim "  would run: launchctl bootstrap gui/$uid $target_plist"
    return 0
  fi

  configure_macos_dotfiles_launchagent "$dry" clipboard-notify "dotfiles-clipboard-notify watch" "$script"
}

# A font cask can stay registered in brew while the copied files are gone, so
# verify the declared JetBrainsMono Nerd Font files and repair them if needed.
configure_macos_jetbrains_mono_font() {
  local dry="$1" f caskroom
  package_declared_short font-jetbrains-mono-nerd-font || return 0
  command -v brew >/dev/null 2>&1 || return 0
  for f in "$HOME/Library/Fonts"/JetBrainsMonoNerdFont*.ttf /Library/Fonts/JetBrainsMonoNerdFont*.ttf; do
    [[ -f "$f" ]] && return 0
  done
  # The Caskroom keeps the font artifacts even when the per-user copies are
  # missing (cask fonts land in the INSTALLING user's ~/Library/Fonts, so a
  # brew set up by another account never gave this user the files). Copying
  # from the Caskroom needs no brew write access.
  caskroom="$(_macos_brew_prefix)/Caskroom/font-jetbrains-mono-nerd-font"
  if [[ -n "$(find "$caskroom" -name 'JetBrainsMonoNerdFont*.ttf' 2>/dev/null | head -n 1)" ]]; then
    if [[ "$dry" -eq 1 ]]; then
      dim "  would copy JetBrainsMono Nerd Font files from Caskroom to ~/Library/Fonts"
      return 0
    fi
    mkdir -p "$HOME/Library/Fonts"
    if find "$caskroom" -name 'JetBrainsMonoNerdFont*.ttf' -exec cp -L {} "$HOME/Library/Fonts/" \; 2>/dev/null &&
      [[ -f "$HOME/Library/Fonts/JetBrainsMonoNerdFont-Regular.ttf" ]]; then
      ok "installed JetBrainsMono Nerd Font files from brew Caskroom"
      return 0
    fi
  fi
  if [[ "$dry" -eq 1 ]]; then
    dim "  would run: brew reinstall --cask font-jetbrains-mono-nerd-font"
    return 0
  fi
  if brew reinstall --cask font-jetbrains-mono-nerd-font >/dev/null 2>&1; then
    ok "reinstalled JetBrainsMono Nerd Font (files were missing)"
  else
    warn "JetBrainsMono Nerd Font files missing; run: brew reinstall --cask font-jetbrains-mono-nerd-font"
    if ! _macos_brew_prefix_writable; then
      warn "that will keep failing until: sudo chown -R $USER $(_macos_brew_prefix)"
    fi
  fi
}

configure_macos_brew_service() {
  local dry="$1" service="$2" service_cmd
  service_cmd="$(_macos_brew_service_command "$service")"
  if ! command -v brew >/dev/null 2>&1; then
    warn "brew missing; cannot start $service service"
    return 0
  fi
  if ! command -v "$service_cmd" >/dev/null 2>&1; then
    warn "$service is declared but not installed; run dotfiles update again after package install completes"
    return 0
  fi
  if _macos_brew_service_started "$service"; then
    ok "brew service running: $service"
    return 0
  fi
  if [[ "$dry" -eq 1 ]]; then
    dim "  would run: brew services restart $(_macos_brew_service_formula "$service")"
    return 0
  fi
  if brew services restart "$(_macos_brew_service_formula "$service")" >/dev/null; then
    sleep 2
    if _macos_brew_service_started "$service"; then
      ok "brew service running: $service"
    else
      warn "brew service failed after restart: $service"
      _macos_brew_service_log_hint "$service"
    fi
  else
    warn "failed to restart brew service: $service"
    _macos_brew_service_log_hint "$service"
  fi
}

_macos_brew_service_command() {
  case "$1" in
    dbus) printf 'dbus-daemon\n' ;;
    *) printf '%s\n' "$1" ;;
  esac
}

_macos_brew_service_formula() {
  case "$1" in
    borders) printf 'felixkratz/formulae/%s\n' "$1" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

configure_macos_dotfiles_launchagent() {
  local dry="$1" service="$2" process="${3:-$2}" app_path="${4:-}" source_plist target_dir target_plist uid label formula
  label="com.dotfiles.$service"
  formula="$(_macos_brew_service_formula "$service")"
  source_plist="$HOME/.local/share/dotfiles/LaunchAgents/$label.plist"
  if [[ ! -r "$source_plist" ]]; then
    source_plist="$DOTFILES_DIR/stow/os-macos/launchagents/.local/share/dotfiles/LaunchAgents/$label.plist"
  fi
  target_dir="$HOME/Library/LaunchAgents"
  target_plist="$target_dir/$label.plist"
  uid="$(id -u)"

  if [[ -n "$app_path" ]]; then
    if [[ "$app_path" == *.app && ! -d "$app_path" ]]; then
      warn "$service is declared but not installed; run dotfiles update again after package install completes"
      return 0
    elif [[ "$app_path" != *.app && ! -e "$app_path" ]]; then
      warn "$service is declared but not installed; run dotfiles update again after package install completes"
      return 0
    fi
  elif ! command -v "$service" >/dev/null 2>&1; then
    warn "$service is declared but not installed; run dotfiles update again after package install completes"
    return 0
  fi
  if [[ ! -r "$source_plist" ]]; then
    warn "$service LaunchAgent source missing: $source_plist"
    return 0
  fi
  if [[ "$dry" -eq 1 ]]; then
    dim "  would stop Homebrew service: $formula"
    dim "  would install LaunchAgent: $target_plist"
    dim "  would run: launchctl bootstrap gui/$uid $target_plist"
    return 0
  fi

  brew services stop "$formula" >/dev/null 2>&1 || true
  launchctl bootout "gui/$uid/homebrew.mxcl.$service" >/dev/null 2>&1 || true
  launchctl bootout "gui/$uid" "$HOME/Library/LaunchAgents/homebrew.mxcl.$service.plist" >/dev/null 2>&1 || true
  rm -f "$HOME/Library/LaunchAgents/homebrew.mxcl.$service.plist"

  mkdir -p "$target_dir" "$HOME/Library/Logs/dotfiles"
  cp "$source_plist" "$target_plist"
  launchctl bootout "gui/$uid/$label" >/dev/null 2>&1 || true
  launchctl bootout "gui/$uid" "$target_plist" >/dev/null 2>&1 || true
  if launchctl bootstrap "gui/$uid" "$target_plist" >/dev/null 2>&1; then
    launchctl kickstart -k "gui/$uid/$label" >/dev/null 2>&1 || true
    sleep 2
    if _macos_dotfiles_launchagent_running "$service" "$process"; then
      ok "dotfiles LaunchAgent running: $service"
      if _macos_dotfiles_launchagent_background_blocked "$service"; then
        _macos_dotfiles_launchagent_background_hint "$service"
      fi
    else
      warn "dotfiles LaunchAgent loaded but process is not running: $service"
      if _macos_dotfiles_launchagent_background_blocked "$service"; then
        _macos_dotfiles_launchagent_background_hint "$service"
      fi
      _macos_dotfiles_launchagent_log_hint "$service"
    fi
  else
    warn "failed to load dotfiles LaunchAgent: $target_plist"
    _macos_dotfiles_launchagent_log_hint "$service"
  fi
}

# lan-mouse is installed from the pinned upstream release on every platform
# (docs/kvm-sharing.md): macOS has no Homebrew cask, and Omarchy's package
# snapshot can lag on an incompatible pre-DTLS protocol version — peers must
# run matching versions. Bump the version and ALL checksums together.
_LANMOUSE_VERSION="0.11.0"
_LANMOUSE_SHA256_ARM64="5ff9965d05be7f125b1d75b9e7259d874ec98aa086ce40012522bc25406500a9"
_LANMOUSE_SHA256_INTEL="d24c38ccf50061ab710826003c19d10e1243415ffa18f421d4498b2b858c8b64"
_LANMOUSE_SHA256_LINUX_X86_64="c43d211ec1af3eaea0cd585ac5c415776000355c3fcb9742fa2513f32dab55ba"
_LANMOUSE_SHA256_LINUX_ARM64="e0520efe44902c05a7c048124a498313f32b5106189102e72ab0ca9e61096d35"

configure_macos_lanmouse() {
  local dry="$1"
  [[ -e "$HOME/.config/lan-mouse/config.toml" ]] || return 0
  _macos_lanmouse_install_app "$dry" || return 0
  configure_macos_dotfiles_launchagent "$dry" lanmouse lan-mouse "/Applications/Lan Mouse.app"
  [[ "$dry" -eq 1 ]] || _macos_lanmouse_accessibility_hint
}

_macos_lanmouse_installed_version() {
  "/Applications/Lan Mouse.app/Contents/MacOS/lan-mouse" --version 2>/dev/null | awk 'NR==1 {print $2}'
}

_macos_lanmouse_install_app() {
  local dry="$1" arch asset sha url tmp app="/Applications/Lan Mouse.app"
  if [[ -d "$app" && "$(_macos_lanmouse_installed_version)" == "$_LANMOUSE_VERSION" ]]; then
    ok "Lan Mouse $_LANMOUSE_VERSION installed"
    return 0
  fi
  arch="$(uname -m)"
  case "$arch" in
    arm64) asset="lan-mouse-macos-arm64.zip"; sha="$_LANMOUSE_SHA256_ARM64" ;;
    x86_64) asset="lan-mouse-macos-intel.zip"; sha="$_LANMOUSE_SHA256_INTEL" ;;
    *) warn "unsupported macOS architecture for Lan Mouse: $arch"; return 1 ;;
  esac
  url="https://github.com/feschber/lan-mouse/releases/download/v$_LANMOUSE_VERSION/$asset"
  if [[ "$dry" -eq 1 ]]; then
    dim "  would install Lan Mouse $_LANMOUSE_VERSION to $app from $url"
    return 0
  fi

  info "Installing Lan Mouse $_LANMOUSE_VERSION ($asset)"
  tmp="$(mktemp -d)"
  if ! curl -fsSL -o "$tmp/$asset" "$url"; then
    warn "Lan Mouse download failed: $url"
    rm -rf "$tmp"
    return 1
  fi
  if [[ "$(shasum -a 256 "$tmp/$asset" | awk '{print $1}')" != "$sha" ]]; then
    warn "Lan Mouse download failed checksum verification; not installing"
    rm -rf "$tmp"
    return 1
  fi
  if ! ditto -x -k "$tmp/$asset" "$tmp/extract" >/dev/null 2>&1 || [[ ! -d "$tmp/extract/Lan Mouse.app" ]]; then
    warn "Lan Mouse archive did not unpack to the expected app bundle"
    rm -rf "$tmp"
    return 1
  fi
  xattr -rd com.apple.quarantine "$tmp/extract/Lan Mouse.app" >/dev/null 2>&1 || true
  # Stop a running copy before swapping the bundle under it.
  launchctl bootout "gui/$(id -u)/com.dotfiles.lanmouse" >/dev/null 2>&1 || true
  pkill -x lan-mouse >/dev/null 2>&1 || true
  if ! rm -rf "$app" || ! ditto "$tmp/extract/Lan Mouse.app" "$app"; then
    warn "could not install to $app (permissions?); move it manually from $tmp/extract"
    return 1
  fi
  rm -rf "$tmp"
  if [[ "$(_macos_lanmouse_installed_version)" == "$_LANMOUSE_VERSION" ]]; then
    ok "Lan Mouse $_LANMOUSE_VERSION installed"
  else
    warn "Lan Mouse installed but version check failed; inspect $app"
    return 1
  fi
}

# Input capture/emulation need the one-time Accessibility grant; the daemon
# logs the refusal, which is the only reliable unprivileged signal.
_macos_lanmouse_accessibility_hint() {
  local log="$HOME/Library/Logs/dotfiles/lanmouse.err.log"
  [[ -s "$log" ]] || return 0
  if tail -n 20 "$log" 2>/dev/null | grep -q 'accessibility permission is required'; then
    warn "Lan Mouse needs the one-time Accessibility grant to send/receive input"
    warn "System Settings -> Privacy & Security -> Accessibility -> enable 'lan-mouse'"
    warn "then restart it: launchctl kickstart -k gui/$(id -u)/com.dotfiles.lanmouse"
  fi
}

_macos_mas_doctor() {
  local id installed missing=()
  local ids=()
  while read -r id; do
    [[ -n "$id" ]] && ids+=("$id")
  done < <(desired_mas_packages)
  [[ ${#ids[@]} -gt 0 ]] || return 0
  if ! command -v mas >/dev/null 2>&1; then
    warn "mas missing; declared App Store apps are unmanaged"
    return 1
  fi
  installed="$(mas list 2>/dev/null | awk '{print $1}')"
  for id in "${ids[@]}"; do
    grep -Fxq "$id" <<<"$installed" || missing+=("$id")
  done
  if [[ ${#missing[@]} -eq 0 ]]; then
    ok "all App Store apps installed"
  else
    warn "missing App Store app id(s): ${missing[*]}; sign into the App Store, then run dotfiles update"
    return 1
  fi
}

configure_macos_dock_defaults() {
  local dry="$1"
  if _macos_dock_defaults_match; then
    ok "Dock and desktop defaults applied"
    return 0
  fi
  if [[ "$dry" -eq 1 ]]; then
    dim "  would run: defaults write com.apple.dock autohide -bool true"
    dim "  would run: defaults write com.apple.dock orientation bottom"
    dim "  would run: defaults write com.apple.dock tilesize -int 47"
    dim "  would run: defaults write com.apple.dock show-recents -bool false"
    dim "  would run: defaults write com.apple.WindowManager EnableStandardClickToShowDesktop -bool false"
    dim "  would run: killall Dock"
    return 0
  fi
  defaults write com.apple.dock autohide -bool true
  defaults write com.apple.dock orientation bottom
  defaults write com.apple.dock tilesize -int 47
  defaults write com.apple.dock show-recents -bool false
  defaults write com.apple.WindowManager EnableStandardClickToShowDesktop -bool false
  killall Dock >/dev/null 2>&1 || true
  ok "Dock and desktop defaults applied"
}

configure_macos_finder_defaults() {
  local dry="$1" home_url
  home_url="file://$HOME/"
  # Skip (and never killall Finder) when everything already matches: a Finder
  # restart closes windows and churns user session state, so it must only
  # happen when a managed default actually changed.
  if _macos_finder_defaults_match; then
    ok "Finder defaults applied"
    return 0
  fi
  if [[ "$dry" -eq 1 ]]; then
    dim "  would run: defaults write com.apple.finder NewWindowTarget PfHm"
    dim "  would run: defaults write com.apple.finder NewWindowTargetPath $home_url"
    dim "  would run: defaults write com.apple.finder FXPreferredViewStyle clmv"
    dim "  would run: defaults write com.apple.finder ShowPathbar -bool true"
    dim "  would run: defaults write com.apple.finder ShowStatusBar -bool true"
    dim "  would run: defaults write com.apple.finder FXDefaultSearchScope SCcf"
    dim "  would run: defaults write com.apple.finder AppleShowAllFiles -bool true"
    dim "  would run: defaults write -g AppleShowAllExtensions -bool true"
    dim "  would run: killall Finder"
    return 0
  fi
  defaults write com.apple.finder NewWindowTarget PfHm
  defaults write com.apple.finder NewWindowTargetPath "$home_url"
  defaults write com.apple.finder FXPreferredViewStyle clmv
  defaults write com.apple.finder ShowPathbar -bool true
  defaults write com.apple.finder ShowStatusBar -bool true
  defaults write com.apple.finder FXDefaultSearchScope SCcf
  defaults write com.apple.finder AppleShowAllFiles -bool true
  defaults write -g AppleShowAllExtensions -bool true
  killall Finder >/dev/null 2>&1 || true
  ok "Finder defaults applied"
}

configure_macos_input_defaults() {
  local dry="$1"
  # Natural scrolling stays ON globally (trackpad behavior); LinearMouse
  # reverses vertical scroll for mice only via the stowed linearmouse.json,
  # since macOS has no native per-device scroll direction.
  if _macos_input_defaults_match; then
    ok "macOS input defaults applied"
    return 0
  fi
  if [[ "$dry" -eq 1 ]]; then
    dim "  would run: defaults write -g com.apple.swipescrolldirection -bool true"
    dim "  would run: defaults write com.apple.AppleMultitouchTrackpad Clicking -bool true"
    dim "  would run: defaults write -g KeyRepeat -int 2"
    dim "  would run: defaults write -g InitialKeyRepeat -int 15"
    dim "  would run: defaults write -g ApplePressAndHoldEnabled -bool false"
    return 0
  fi
  defaults write -g com.apple.swipescrolldirection -bool true
  defaults write com.apple.AppleMultitouchTrackpad Clicking -bool true
  defaults write -g KeyRepeat -int 2
  defaults write -g InitialKeyRepeat -int 15
  defaults write -g ApplePressAndHoldEnabled -bool false
  ok "macOS input defaults applied"
  warn "scroll direction changes may need a log out/in to affect running apps"
}

configure_macos_aerospace() {
  local dry="$1"
  [[ -d /Applications/AeroSpace.app ]] || return 0
  _macos_aerospace_config_cleanup "$dry"
  if pgrep -x AeroSpace >/dev/null 2>&1; then
    if _macos_aerospace_responding && aerospace reload-config >/dev/null 2>&1; then
      ok "AeroSpace running and responding"
      return 0
    fi
    if [[ "$dry" -eq 1 ]]; then
      dim "  would restart AeroSpace (running but not responding to CLI checks)"
      return 0
    fi
    # A restart recovers from startup errors such as the ambiguous-config
    # refusal; a plain reload-config cannot reach a wedged instance.
    warn "AeroSpace running but not responding; restarting it"
    pkill -x AeroSpace >/dev/null 2>&1 || true
    sleep 1
  elif [[ "$dry" -eq 1 ]]; then
    dim "  would run: open -ga AeroSpace"
    return 0
  fi
  if open -ga AeroSpace >/dev/null 2>&1; then
    sleep 2
    if _macos_aerospace_responding; then
      ok "AeroSpace running and responding"
    else
      warn "AeroSpace launched but CLI checks still fail: $(_macos_aerospace_cli_error)"
      warn "grant Accessibility: System Settings -> Privacy & Security -> Accessibility"
    fi
  else
    warn "failed to launch AeroSpace; open it from /Applications and grant Accessibility permission if prompted"
  fi
}

_macos_aerospace_responding() {
  command -v aerospace >/dev/null 2>&1 || return 1
  aerospace list-workspaces --focused >/dev/null 2>&1
}

_macos_aerospace_cli_error() {
  if ! command -v aerospace >/dev/null 2>&1; then
    printf 'aerospace CLI not in PATH\n'
    return 0
  fi
  aerospace list-workspaces --focused 2>&1 | head -n 1 || true
}

# AeroSpace refuses to load when its config exists in both supported
# locations (~/.aerospace.toml and the XDG path). The XDG file is the managed
# one; remove a root-level link only if it is a stale stow link into this repo.
_macos_aerospace_config_cleanup() {
  local dry="$1" root_cfg="$HOME/.aerospace.toml" xdg_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/aerospace/aerospace.toml" link_target
  [[ -e "$xdg_cfg" ]] || return 0
  [[ -e "$root_cfg" || -L "$root_cfg" ]] || return 0
  if [[ -L "$root_cfg" ]]; then
    link_target="$(readlink "$root_cfg" 2>/dev/null || true)"
    case "$link_target" in
      *"/stow/os-macos/aerospace/"*)
        if [[ "$dry" -eq 1 ]]; then
          dim "  would remove stale AeroSpace config link: $root_cfg"
        else
          rm -f "$root_cfg"
          ok "removed stale AeroSpace config link: $root_cfg"
        fi
        return 0
        ;;
    esac
  fi
  warn "AeroSpace config exists in both $root_cfg and $xdg_cfg; AeroSpace refuses this ambiguity — keep only the XDG file"
}

configure_macos_desktop_apps() {
  local dry="$1"
  configure_macos_app_launch "$dry" Raycast /Applications/Raycast.app Raycast
  configure_macos_raycast_hotkey "$dry"
  configure_macos_app_launch "$dry" Rectangle /Applications/Rectangle.app Rectangle
  configure_macos_rectangle_defaults "$dry"
}

# Rectangle only activates shortcuts after its first-launch dialog is
# answered; we launch it in the background so that dialog is never seen.
# Presetting alternateDefaultShortcuts selects the recommended shortcut set.
configure_macos_rectangle_defaults() {
  local dry="$1"
  [[ -d /Applications/Rectangle.app ]] || return 0
  if defaults read com.knollsoft.Rectangle alternateDefaultShortcuts >/dev/null 2>&1; then
    ok "Rectangle shortcuts initialized"
    return 0
  fi
  if [[ "$dry" -eq 1 ]]; then
    dim "  would run: defaults write com.knollsoft.Rectangle alternateDefaultShortcuts -bool true"
    dim "  would run: defaults write com.knollsoft.Rectangle launchOnLogin -bool true"
    dim "  would restart Rectangle to activate the recommended shortcuts"
    return 0
  fi
  defaults write com.knollsoft.Rectangle alternateDefaultShortcuts -bool true
  defaults write com.knollsoft.Rectangle launchOnLogin -bool true
  if pgrep -x Rectangle >/dev/null 2>&1; then
    killall Rectangle >/dev/null 2>&1 || true
    sleep 1
    open -ga Rectangle >/dev/null 2>&1 || true
  fi
  ok "Rectangle recommended shortcuts enabled (needs Accessibility to act)"
}

# Cmd-Space for Raycast is two prefs: Spotlight's symbolic hotkey 64 must be
# disabled, and Raycast reads raycastGlobalHotkey at launch (hence the
# restart when the value changes).
configure_macos_raycast_hotkey() {
  local dry="$1"
  [[ -d /Applications/Raycast.app ]] || return 0
  if [[ "$(defaults read com.raycast.macos raycastGlobalHotkey 2>/dev/null || true)" == "Command-49" ]]; then
    ok "Raycast hotkey set to Cmd-Space"
    return 0
  fi
  if [[ "$dry" -eq 1 ]]; then
    dim "  would disable Spotlight Cmd-Space (symbolic hotkey 64)"
    dim "  would run: defaults write com.raycast.macos raycastGlobalHotkey Command-49"
    dim "  would restart Raycast to pick up the hotkey"
    return 0
  fi
  defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 64 '<dict><key>enabled</key><false/></dict>'
  /System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u >/dev/null 2>&1 || true
  defaults write com.raycast.macos raycastGlobalHotkey -string "Command-49"
  if pgrep -x Raycast >/dev/null 2>&1; then
    killall Raycast >/dev/null 2>&1 || true
    sleep 1
    open -ga Raycast >/dev/null 2>&1 || true
  fi
  ok "Raycast hotkey set to Cmd-Space (Spotlight shortcut disabled)"
}

configure_macos_app_launch() {
  local dry="$1" name="$2" path="$3" process="$4"
  [[ -d "$path" ]] || return 0
  if pgrep -x "$process" >/dev/null 2>&1; then
    ok "$name running"
    return 0
  fi
  if [[ "$dry" -eq 1 ]]; then
    dim "  would run: open -ga $name"
    return 0
  fi
  if open -ga "$name" >/dev/null 2>&1; then
    ok "$name launched"
  else
    warn "failed to launch $name from $path"
  fi
}

wallpaper_config_file() {
  printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/wallpapers.conf"
}

wallpaper_load_config() {
  WALLPAPER_ROTATION_ENABLED=1
  WALLPAPER_ROTATION_INTERVAL="15m"
  WALLPAPER_ROTATION_MODE="random"
  WALLPAPER_REPO_DIR="$HOME/.local/share/wallpapers/shared"
  WALLPAPER_LOCAL_DIR="$HOME/Pictures/local-wallpapers"
  local config
  config="$(wallpaper_config_file)"
  if [[ -r "$config" ]]; then
    # shellcheck disable=SC1090
    . "$config"
  fi
}

wallpaper_count_in() {
  local dir="$1" count=0 file
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    count=$((count + 1))
  done < <(find -L "$dir" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -print 2>/dev/null || true)
  printf '%s\n' "$count"
}

configure_wallpaper_rotation() {
  local dry="$1" os
  os="$(detect_os)"
  case "$os" in omarchy|macos) ;; *) return 0 ;; esac
  wallpaper_load_config

  if [[ "$dry" -eq 1 ]]; then
    dim "  would create local wallpaper folder: $WALLPAPER_LOCAL_DIR"
  else
    mkdir -p "$WALLPAPER_LOCAL_DIR"
  fi

  if [[ "$os" == "macos" ]]; then
    if [[ "$WALLPAPER_ROTATION_ENABLED" == "1" ]]; then
      configure_macos_wallpaper_launchagent "$dry"
    else
      dim "  macOS wallpaper rotation disabled in $(wallpaper_config_file)"
    fi
    return 0
  fi

  command -v systemctl >/dev/null 2>&1 || return 0
  if ! systemd_user_ready; then
    warn "user systemd manager is not reachable; wallpaper timer will be enabled on next update/login"
    return 0
  fi

  if [[ "$WALLPAPER_ROTATION_ENABLED" == "1" ]]; then
    if [[ "$dry" -eq 1 ]]; then
      dim "  would run: systemctl --user enable --now dotfiles-wallpaper-rotate.timer"
    else
      systemctl --user enable --now dotfiles-wallpaper-rotate.timer >/dev/null 2>&1 || warn "failed to enable wallpaper rotation timer"
    fi
  else
    if [[ "$dry" -eq 1 ]]; then
      dim "  would run: systemctl --user disable --now dotfiles-wallpaper-rotate.timer"
    else
      systemctl --user disable --now dotfiles-wallpaper-rotate.timer >/dev/null 2>&1 || true
    fi
  fi
}

configure_macos_wallpaper_launchagent() {
  local dry="$1" source_plist target_dir target_plist uid
  source_plist="$HOME/.local/share/dotfiles/com.dotfiles.wallpaper.plist"
  target_dir="$HOME/Library/LaunchAgents"
  target_plist="$target_dir/com.dotfiles.wallpaper.plist"

  if [[ ! -r "$source_plist" ]]; then
    warn "macOS wallpaper LaunchAgent source missing: $source_plist"
    return 0
  fi
  if [[ "$dry" -eq 1 ]]; then
    dim "  would install LaunchAgent: $target_plist"
    dim "  would run: launchctl bootstrap gui/$(id -u) $target_plist"
    return 0
  fi

  mkdir -p "$target_dir"
  cp "$source_plist" "$target_plist"
  uid="$(id -u)"
  launchctl bootout "gui/$uid/com.dotfiles.wallpaper" >/dev/null 2>&1 || true
  if launchctl bootstrap "gui/$uid" "$target_plist" >/dev/null 2>&1; then
    launchctl kickstart -k "gui/$uid/com.dotfiles.wallpaper" >/dev/null 2>&1 || true
    ok "macOS wallpaper LaunchAgent loaded"
  else
    warn "failed to load macOS wallpaper LaunchAgent: $target_plist"
  fi
}

wallpaper_status_lines() {
  if wallpaper_engine_cmd status; then
    return 0
  fi
  wallpaper_load_config
  printf 'enabled: %s\n' "$WALLPAPER_ROTATION_ENABLED"
  printf 'interval: %s\n' "$WALLPAPER_ROTATION_INTERVAL"
  printf 'mode: %s\n' "$WALLPAPER_ROTATION_MODE"
  printf 'repo_dir: %s\n' "$WALLPAPER_REPO_DIR"
  printf 'repo_wallpapers: %s\n' "$(wallpaper_count_in "$WALLPAPER_REPO_DIR")"
  printf 'local_dir: %s\n' "$WALLPAPER_LOCAL_DIR"
  printf 'local_wallpapers: %s\n' "$(wallpaper_count_in "$WALLPAPER_LOCAL_DIR")"
}

wallpaper_engine_cmd() {
  if command -v dotfiles-wallpaper >/dev/null 2>&1; then
    dotfiles-wallpaper "$@"
  elif [[ -x "$HOME/.local/bin/dotfiles-wallpaper" ]]; then
    "$HOME/.local/bin/dotfiles-wallpaper" "$@"
  elif [[ -x "$DOTFILES_DIR/stow/global/wallpapers/.local/bin/dotfiles-wallpaper" ]]; then
    "$DOTFILES_DIR/stow/global/wallpapers/.local/bin/dotfiles-wallpaper" "$@"
  else
    return 1
  fi
}

cmd_wallpaper() {
  local subcmd="${1:-status}"
  case "$subcmd" in
    rotate)
      wallpaper_engine_cmd rotate --force
      ;;
    status)
      wallpaper_status_lines
      ;;
    open-local)
      wallpaper_engine_cmd open-local
      ;;
    set)
      shift || true
      wallpaper_engine_cmd set "$@"
      ;;
    help|-h|--help|"")
      printf 'Usage:\n  dotfiles wallpaper rotate\n  dotfiles wallpaper status\n  dotfiles wallpaper open-local\n  dotfiles wallpaper set <file>\n'
      ;;
    *) err "unknown wallpaper subcommand: $subcmd"; return 1 ;;
  esac
}

# --- oled guard -----------------------------------------------------------
oled_state_file() {
  printf '%s/dotfiles/oled-fornax\n' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

oled_current_mode() {
  local state
  state="$(sed -n '1p' "$(oled_state_file)" 2>/dev/null || true)"
  case "$state" in
    on|oled) printf 'on\n' ;;
    *) printf 'off\n' ;;
  esac
}

oled_require_fornax() {
  local os host
  os="$(detect_os)"
  host="$(detect_hostname)"
  if [[ "$os" != "omarchy" || "$host" != "fornax" ]]; then
    err "dotfiles oled is only supported on fornax Omarchy systems"
    printf '  current: %s (%s)\n' "$host" "$os" >&2
    return 1
  fi
}

oled_restart_hypridle() {
  if systemd_user_unit_active hypridle.service; then
    if systemctl --user restart hypridle.service >/dev/null 2>&1; then
      ok "hypridle restarted"
    else
      warn "failed to restart hypridle.service"
    fi
  elif pgrep -x hypridle >/dev/null 2>&1; then
    pkill -x hypridle >/dev/null 2>&1 || true
    if command -v hypridle >/dev/null 2>&1; then
      hypridle >/dev/null 2>&1 &
      ok "hypridle restarted"
    else
      warn "hypridle process was running but hypridle command is missing"
    fi
  else
    warn "hypridle is not running; it will use the selected mode next time it starts"
  fi
}

oled_run_action() {
  local action="$1"
  case "$action" in
    dim) brightnessctl -s set 10 ;;
    lock) omarchy-system-lock ;;
    screensaver) pidof hyprlock >/dev/null 2>&1 || omarchy-launch-screensaver ;;
    display-off) hyprctl dispatch dpms off ;;
    suspend) systemctl suspend ;;
    *) return 1 ;;
  esac
}

oled_run_resume() {
  local action="$1"
  case "$action" in
    dim) brightnessctl -r ;;
    display-off) hyprctl dispatch dpms on ;;
    *) return 0 ;;
  esac
}

oled_internal_event() {
  local event_mode="$1" action="$2" current
  current="$(oled_current_mode)"
  if [[ "$event_mode" == "oled" && "$current" != "on" ]]; then
    return 0
  fi
  if [[ "$event_mode" == "default" && "$current" == "on" ]]; then
    return 0
  fi
  oled_run_action "$action"
}

oled_internal_resume() {
  local event_mode="$1" action="$2" current
  current="$(oled_current_mode)"
  if [[ "$event_mode" == "oled" && "$current" != "on" ]]; then
    return 0
  fi
  if [[ "$event_mode" == "default" && "$current" == "on" ]]; then
    return 0
  fi
  oled_run_resume "$action"
}

cmd_oled() {
  local subcmd="${1:-status}" state_file
  case "$subcmd" in
    on)
      oled_require_fornax || return 1
      state_file="$(oled_state_file)"
      mkdir -p "$(dirname "$state_file")"
      printf 'on\n' >"$state_file"
      ok "fornax OLED protection enabled"
      oled_restart_hypridle
      ;;
    off)
      oled_require_fornax || return 1
      state_file="$(oled_state_file)"
      mkdir -p "$(dirname "$state_file")"
      printf 'off\n' >"$state_file"
      ok "fornax OLED protection disabled"
      oled_restart_hypridle
      ;;
    status)
      oled_require_fornax || return 1
      printf 'OLED protection: %s\n' "$(oled_current_mode)"
      if [[ "$(oled_current_mode)" == "on" ]]; then
        printf '  active policy: 10 min dim, 35 min screensaver, 1 hr lock, 120 min display off, 5 hr suspend\n'
      else
        printf '  active policy: 3 min dim, 10 min lock, 15 min display off, 60 min suspend\n'
      fi
      ;;
    _timeout)
      shift
      oled_internal_event "${1:-}" "${2:-}"
      ;;
    _resume)
      shift
      oled_internal_resume "${1:-}" "${2:-}"
      ;;
    help|-h|--help|"")
      printf 'Usage:\n  dotfiles oled on\n  dotfiles oled off\n  dotfiles oled status\n'
      ;;
    *)
      err "unknown oled command: $subcmd"
      printf 'Usage:\n  dotfiles oled on\n  dotfiles oled off\n  dotfiles oled status\n' >&2
      return 1
      ;;
  esac
}

# --- local LLM / OpenCode fleet -------------------------------------------
opencode_config_path() {
  if [[ -f "$DOTFILES_DIR/stow/global/opencode/.config/opencode/opencode.json" ]]; then
    printf '%s\n' "$DOTFILES_DIR/stow/global/opencode/.config/opencode/opencode.json"
  else
    printf '%s\n' "$HOME/.config/opencode/opencode.json"
  fi
}

llm_require_jq() {
  if ! command -v jq >/dev/null 2>&1; then
    err "jq is required for dotfiles llm commands"
    printf '  run: dotfiles update\n' >&2
    return 1
  fi
}

llm_provider_for_host() {
  printf 'ollama-%s\n' "$(detect_hostname)"
}

llm_config_provider_exists() {
  local provider="$1" config
  llm_require_jq >/dev/null || return 1
  config="$(opencode_config_path)"
  [[ -f "$config" ]] || return 1
  jq -e --arg provider "$provider" '.provider[$provider] != null' "$config" >/dev/null
}

llm_providers() {
  local config
  llm_require_jq || return 1
  config="$(opencode_config_path)"
  [[ -f "$config" ]] || { err "opencode config not found: $config"; return 1; }
  jq -r '.provider // {} | keys[] | select(startswith("ollama-"))' "$config"
}

llm_provider_url() {
  local provider="$1" config
  config="$(opencode_config_path)"
  jq -r --arg provider "$provider" '.provider[$provider].options.baseURL // ""' "$config"
}

llm_ollama_root() {
  local url="$1"
  url="${url%/}"
  printf '%s\n' "${url%/v1}"
}

llm_ollama_hostport() {
  local url="$1" root
  root="$(llm_ollama_root "$url")"
  root="${root#http://}"
  root="${root#https://}"
  printf '%s\n' "${root%%/*}"
}

llm_provider_models() {
  local provider="$1" config
  config="$(opencode_config_path)"
  jq -r --arg provider "$provider" '.provider[$provider].models // {} | keys[]' "$config"
}

llm_local_models() {
  local root="$1"
  OLLAMA_HOST="$root" ollama list 2>/dev/null | awk 'NR > 1 { print $1 }'
}

llm_provider_default_context() {
  local provider="$1"
  case "$provider" in
    ollama-fornax) printf '65536\n' ;;
    *) printf '32768\n' ;;
  esac
}

llm_version_lt() {
  local left="$1" right="$2" first
  [[ "$left" == "$right" ]] && return 1
  first="$(printf '%s\n%s\n' "$left" "$right" | sort -V | sed -n '1p')"
  [[ "$first" == "$left" ]]
}

llm_api_version() {
  local root="$1" json
  json="$(llm_curl_json "$root/api/version")" || return 1
  jq -r '.version // empty' <<<"$json"
}

llm_sync_opencode_models() {
  local provider="$1" root="$2" config tmp models_json context host added=()
  config="$(opencode_config_path)"
  tmp="$(mktemp)"
  context="$(llm_provider_default_context "$provider")"
  host="${provider#ollama-}"
  models_json="$(llm_local_models "$root" | jq -Rsc 'split("\n") | map(select(length > 0))')"

  while read -r model; do
    [[ -n "$model" ]] || continue
    if ! llm_provider_models "$provider" | grep -Fxq "$model"; then
      added+=("$model")
    fi
  done < <(jq -r '.[]' <<<"$models_json")

  jq --arg provider "$provider" --arg host "$host" --argjson models "$models_json" --argjson context "$context" '
    def model_name($model; $host):
      ($model
        | sub(":latest$"; "")
        | gsub("[-_.:]"; " ")
        | split(" ")
        | map(if length > 0 then (.[0:1] | ascii_upcase) + .[1:] else . end)
        | join(" ")) + " - " + $host;
    (.provider[$provider].models // {}) as $existing |
    reduce $models[] as $model (.;
      .provider[$provider].models[$model] = (
        ($existing[$model] // {}) + {
          name: (($existing[$model].name // model_name($model; $host))),
          tool_call: (($existing[$model].tool_call // true)),
          limit: (($existing[$model].limit // {context: $context, output: 8192}))
        }
      )
    )
  ' "$config" >"$tmp"
  install -m 0644 "$tmp" "$config"
  rm -f "$tmp"

  if [[ ${#added[@]} -gt 0 ]]; then
    ok "added $provider model(s) to OpenCode: ${added[*]}"
  else
    ok "OpenCode already declares installed $provider models"
  fi
}

llm_ensure_current_fornax_ollama() {
  local root="$1" current latest
  [[ "$(detect_os)" == "omarchy" && "$(detect_hostname)" == "fornax" ]] || return 0
  command -v curl >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0
  current="$(llm_api_version "$root" 2>/dev/null || true)"
  latest="$(llm_latest_ollama_release 2>/dev/null || true)"
  [[ "$latest" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 0
  if [[ -z "$current" || "$current" == "unknown" || "$current" == "$latest" ]]; then
    return 0
  fi
  if llm_version_lt "$current" "$latest"; then
    warn "Ollama $current is older than upstream $latest; installing upstream binary for configured models"
    cmd_llm_install_upstream_ollama "$latest"
  fi
}

llm_local_ollama_url() {
  local provider url
  provider="$(llm_provider_for_host)"
  llm_config_provider_exists "$provider" || return 1
  url="$(llm_provider_url "$provider")"
  llm_ollama_root "$url"
}

llm_curl_json() {
  local url="$1"
  command -v curl >/dev/null 2>&1 || return 1
  curl -fsS --max-time 3 "$url" 2>/dev/null
}

llm_latest_ollama_release() {
  curl -fsSL --retry 3 --connect-timeout 10 https://api.github.com/repos/ollama/ollama/releases/latest |
    jq -r '.tag_name' | sed 's/^v//'
}

llm_upstream_ollama_bin() {
  if [[ -x /opt/ollama-current/bin/ollama ]]; then
    printf '/opt/ollama-current/bin/ollama\n'
  fi
}

cmd_llm_install_upstream_ollama() {
  local version="${1:-latest}" tag asset sum_asset base_url tmp archive sums expected actual install_dir current_link upstream_bin
  if [[ "$(detect_os)" != "omarchy" || "$(detect_hostname)" != "fornax" ]]; then
    err "upstream Ollama install is only intended for fornax Omarchy"
    return 1
  fi
  command -v curl >/dev/null 2>&1 || { err "curl is required"; return 1; }
  command -v jq >/dev/null 2>&1 || { err "jq is required"; return 1; }
  command -v sha256sum >/dev/null 2>&1 || { err "sha256sum is required"; return 1; }
  command -v tar >/dev/null 2>&1 || { err "tar is required"; return 1; }

  if [[ "$version" == "latest" ]]; then
    version="$(llm_latest_ollama_release)"
  fi
  version="${version#v}"
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { err "invalid Ollama version: $version"; return 1; }

  tag="v$version"
  asset="ollama-linux-amd64.tar.zst"
  sum_asset="sha256sum.txt"
  base_url="https://github.com/ollama/ollama/releases/download/$tag"
  tmp="$(mktemp -d)"
  archive="$tmp/$asset"
  sums="$tmp/$sum_asset"
  install_dir="/opt/ollama-$version"
  current_link="/opt/ollama-current"

  cleanup() { [[ -n "${tmp:-}" ]] && rm -rf "$tmp"; }
  trap cleanup RETURN

  if ! sudo -v; then
    err "sudo authentication is required; run from an interactive terminal: dotfiles llm sync"
    return 1
  fi

  info "Downloading Ollama $version upstream binary"
  curl -fsSL --retry 3 --connect-timeout 10 -o "$archive" "$base_url/$asset"
  curl -fsSL --retry 3 --connect-timeout 10 -o "$sums" "$base_url/$sum_asset"
  expected="$(awk -v asset="./$asset" '$2 == asset { print $1 }' "$sums")"
  [[ "$expected" =~ ^[0-9a-f]{64}$ ]] || { err "could not find checksum for $asset"; return 1; }
  actual="$(sha256sum "$archive" | awk '{ print $1 }')"
  if [[ "$actual" != "$expected" ]]; then
    err "checksum mismatch for $asset"
    printf '  expected: %s\n  actual:   %s\n' "$expected" "$actual" >&2
    return 1
  fi

  sudo rm -rf "$install_dir" || return 1
  sudo install -d -m 0755 "$install_dir" || return 1
  sudo tar -C "$install_dir" -xf "$archive" || return 1
  sudo ln -sfn "$install_dir" "$current_link" || return 1
  sudo ln -sfn "$current_link/bin/ollama" /usr/local/bin/ollama || return 1
  upstream_bin="$current_link/bin/ollama"
  "$upstream_bin" --version || true
  ok "installed upstream Ollama $version at $install_dir"
  cleanup
  trap - RETURN
  tmp=""
  cmd_llm_setup_host
}

cmd_llm_models() {
  local provider url model
  while read -r provider; do
    [[ -n "$provider" ]] || continue
    url="$(llm_provider_url "$provider")"
    printf '%s\n' "$provider"
    printf '  url: %s\n' "$url"
    while read -r model; do
      [[ -n "$model" ]] && printf '  model: %s\n' "$model"
    done < <(llm_provider_models "$provider")
  done < <(llm_providers)
}

cmd_llm_status() {
  local provider url root version hostport missing_config=() missing_local=()
  while read -r provider; do
    [[ -n "$provider" ]] || continue
    missing_config=()
    missing_local=()
    url="$(llm_provider_url "$provider")"
    root="$(llm_ollama_root "$url")"
    hostport="$(llm_ollama_hostport "$url")"
    printf '%s\n' "$provider"
    printf '  endpoint: %s\n' "$url"
    if version="$(llm_curl_json "$root/api/version")"; then
      printf '  api: reachable (%s)\n' "$(jq -r '.version // "unknown"' <<<"$version" 2>/dev/null || printf unknown)"
    else
      printf '  api: unavailable\n'
    fi
    if command -v ollama >/dev/null 2>&1 && llm_curl_json "$root/api/version" >/dev/null; then
      while read -r model; do
        [[ -n "$model" ]] || continue
        if ! llm_provider_models "$provider" | grep -Fxq "$model"; then
          missing_config+=("$model")
        fi
      done < <(llm_local_models "$root")
      while read -r model; do
        [[ -n "$model" ]] || continue
        if ! llm_local_models "$root" | grep -Fxq "$model"; then
          missing_local+=("$model")
        fi
      done < <(llm_provider_models "$provider")
      if [[ ${#missing_config[@]} -gt 0 ]]; then
        printf '  opencode missing: %s\n' "${missing_config[*]}"
      else
        printf '  opencode: all installed models declared\n'
      fi
      if [[ ${#missing_local[@]} -gt 0 ]]; then
        printf '  ollama missing: %s\n' "${missing_local[*]}"
      else
        printf '  ollama: all declared models installed\n'
      fi
    fi
    if command -v tailscale >/dev/null 2>&1 && [[ "$hostport" == 100.* ]]; then
      if tailscale ping --timeout=2s --c 1 "${hostport%%:*}" >/dev/null 2>&1; then
        printf '  tailscale: reachable\n'
      else
        printf '  tailscale: no ping response\n'
      fi
    fi
  done < <(llm_providers)
}

cmd_llm_sync() {
  local provider model missing=() answer root
  provider="$(llm_provider_for_host)"
  if ! llm_config_provider_exists "$provider"; then
    warn "this host has no Ollama provider in opencode config: $provider"
    return 0
  fi
  if ! command -v ollama >/dev/null 2>&1; then
    err "ollama is not installed on this host"
    return 1
  fi
  root="$(llm_ollama_root "$(llm_provider_url "$provider")")"
  llm_sync_opencode_models "$provider" "$root"
  llm_ensure_current_fornax_ollama "$root" || return 1
  root="$(llm_ollama_root "$(llm_provider_url "$provider")")"
  while read -r model; do
    [[ -n "$model" ]] || continue
    if ! llm_local_models "$root" | grep -Fxq "$model"; then
      missing+=("$model")
    fi
  done < <(llm_provider_models "$provider")
  if [[ ${#missing[@]} -eq 0 ]]; then
    ok "all declared $provider models are installed"
    return 0
  fi
  printf 'Missing %s model(s): %s\n' "${#missing[@]}" "${missing[*]}"
  if ! have_tty; then
    warn "no TTY; run manually: ollama pull ${missing[*]}"
    return 1
  fi
  printf 'Pull these Ollama model(s) now? [y/N] ' >/dev/tty
  IFS= read -r answer </dev/tty || true
  case "$answer" in
    y|Y|yes|YES)
      for model in "${missing[@]}"; do
        OLLAMA_HOST="$root" ollama pull "$model"
      done
      ;;
    *) warn "model pull skipped" ;;
  esac
}

cmd_llm_setup_host() {
  local provider url hostport root bind_hostport tmp tries=0 upstream_bin
  provider="$(llm_provider_for_host)"
  llm_config_provider_exists "$provider" || { err "no provider declared for this host: $provider"; return 1; }
  command -v systemctl >/dev/null 2>&1 || { err "systemctl is required"; return 1; }
  command -v ollama >/dev/null 2>&1 || { err "ollama is not installed"; return 1; }
  url="$(llm_provider_url "$provider")"
  root="$(llm_ollama_root "$url")"
  hostport="$(llm_ollama_hostport "$url")"
  bind_hostport="0.0.0.0:${hostport##*:}"
  upstream_bin="$(llm_upstream_ollama_bin || true)"
  if ! sudo -v; then
    err "sudo authentication is required; run from an interactive terminal: dotfiles llm setup-host"
    return 1
  fi
  tmp="$(mktemp)"
  {
    printf '[Service]\n'
    if [[ -n "$upstream_bin" ]]; then
      printf 'ExecStart=\n'
      printf 'ExecStart=%s serve\n' "$upstream_bin"
    fi
    printf 'Environment="OLLAMA_HOST=%s"\n' "$bind_hostport"
    printf 'Environment="OLLAMA_CONTEXT_LENGTH=65536"\n'
    printf 'Environment="OLLAMA_NUM_PARALLEL=1"\n'
    printf 'Environment="OLLAMA_MAX_LOADED_MODELS=1"\n'
    printf 'Environment="OLLAMA_FLASH_ATTENTION=1"\n'
    printf 'Environment="OLLAMA_KV_CACHE_TYPE=q8_0"\n'
    printf 'Environment="OLLAMA_KEEP_ALIVE=15m"\n'
    printf 'Environment="OLLAMA_NO_CLOUD=1"\n'
  } >"$tmp"
  sudo install -d -m 0755 /etc/systemd/system/ollama.service.d || return 1
  sudo install -m 0644 "$tmp" /etc/systemd/system/ollama.service.d/dotfiles.conf || return 1
  rm -f "$tmp"
  sudo systemctl daemon-reload || return 1
  sudo systemctl enable --now ollama.service || return 1
  sudo systemctl restart ollama.service || return 1
  until llm_curl_json "$root/api/version" >/dev/null; do
    tries=$((tries + 1))
    if [[ "$tries" -ge 10 ]]; then
      err "ollama.service restarted but API is not reachable at $root"
      printf '  inspect: systemctl status ollama.service --no-pager\n' >&2
      printf '  logs   : journalctl -u ollama.service -n 80 --no-pager\n' >&2
      return 1
    fi
    sleep 1
  done
  ok "ollama.service configured for $provider at $hostport"
  if [[ -n "$upstream_bin" ]]; then
    ok "ollama.service uses upstream binary: $upstream_bin"
  fi
}

cmd_llm_doctor() {
  local failed=0 provider url root model ps_output
  llm_require_jq || return 1
  cmd_llm_status || failed=1
  provider="$(llm_provider_for_host)"
  if llm_config_provider_exists "$provider"; then
    info "Local Ollama host checks ($provider)"
    if command -v ollama >/dev/null 2>&1; then
      ok "ollama installed"
    else
      warn "ollama missing"
      failed=1
    fi
    if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet ollama.service 2>/dev/null; then
      ok "ollama.service active"
    else
      warn "ollama.service inactive; run: dotfiles llm setup-host"
      failed=1
    fi
    url="$(llm_provider_url "$provider")"
    root="$(llm_ollama_root "$url")"
    llm_curl_json "$root/api/version" >/dev/null || { warn "local Ollama API unreachable: $root"; failed=1; }
    if command -v ollama >/dev/null 2>&1; then
      while read -r model; do
        [[ -n "$model" ]] || continue
        if OLLAMA_HOST="$root" ollama list 2>/dev/null | awk 'NR > 1 { print $1 }' | grep -Fxq "$model"; then
          ok "model installed: $model"
        else
          warn "model missing: $model"
          failed=1
        fi
      done < <(llm_provider_models "$provider")
      ps_output="$(OLLAMA_HOST="$root" ollama ps 2>/dev/null || true)"
      if [[ -n "$ps_output" ]]; then
        printf '%s\n' "$ps_output"
        if grep -q '100% GPU' <<<"$ps_output"; then
          ok "loaded model is fully GPU-resident"
        else
          warn "no loaded model reports 100% GPU; preload one and check context before long work"
        fi
      fi
    fi
  fi
  return "$failed"
}

cmd_llm() {
  local subcmd="${1:-status}"; shift || true
  case "$subcmd" in
    status) cmd_llm_status "$@" ;;
    models) cmd_llm_models "$@" ;;
    sync) cmd_llm_sync "$@" ;;
    setup-host) cmd_llm_setup_host "$@" ;;
    install-upstream-ollama) cmd_llm_install_upstream_ollama "$@" ;;
    doctor) cmd_llm_doctor "$@" ;;
    help|-h|--help)
      printf 'Usage:\n  dotfiles llm status\n  dotfiles llm models\n  dotfiles llm sync\n  dotfiles llm setup-host\n  dotfiles llm install-upstream-ollama [version|latest]\n  dotfiles llm doctor\n'
      ;;
    *) err "unknown llm command: $subcmd"; return 1 ;;
  esac
}

configure_omarchy_llm_host() {
  local dry="$1" provider
  provider="$(llm_provider_for_host)"
  llm_config_provider_exists "$provider" || return 0
  if [[ "$dry" -eq 1 ]]; then
    dim "  would check local Ollama host setup for $provider"
    return 0
  fi
  if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet ollama.service 2>/dev/null; then
    ok "ollama.service running for $provider"
  else
    warn "local LLM provider declared for this host: $provider"
    warn "run: dotfiles llm setup-host && dotfiles llm sync"
  fi
}

# --- away mode -------------------------------------------------------------
cmd_screen_usage() {
  cat <<'EOF'
Usage:
  dotfiles screen off [--lock] [--pause-lanmouse]
  dotfiles screen on [--resume-lanmouse]
  dotfiles screen status

Options:
  --lock              Lock before turning displays off.
  --pause-lanmouse    Stop lan-mouse so remote/edge input cannot wake displays.
  --resume-lanmouse   Start lan-mouse after turning displays on.
EOF
}

screen_require_omarchy() {
  if [[ "$(detect_os)" != "omarchy" ]]; then
    err "dotfiles screen is only supported on Omarchy/Hyprland systems"
    return 1
  fi
  command -v hyprctl >/dev/null 2>&1 || { err "hyprctl is required"; return 1; }
}

screen_lanmouse_action() {
  local action="$1"
  command -v systemctl >/dev/null 2>&1 || return 0
  systemd_user_ready || return 0
  systemctl --user "$action" lan-mouse.service >/dev/null 2>&1 || true
}

cmd_screen_off() {
  local lock=0 pause_lanmouse=0 arg
  screen_require_omarchy || return 1
  for arg in "$@"; do
    case "$arg" in
      --lock) lock=1 ;;
      --pause-lanmouse|--pause-lan-mouse) pause_lanmouse=1 ;;
      -h|--help) cmd_screen_usage; return 0 ;;
      *) err "unknown screen off option: $arg"; cmd_screen_usage >&2; return 2 ;;
    esac
  done

  if [[ "$pause_lanmouse" -eq 1 ]]; then
    screen_lanmouse_action stop
    ok "lan-mouse stopped"
  fi
  if [[ "$lock" -eq 1 ]]; then
    command -v omarchy-system-lock >/dev/null 2>&1 && omarchy-system-lock >/dev/null 2>&1 || true
  fi
  hyprctl dispatch dpms off >/dev/null
  ok "display power off requested"
}

cmd_screen_on() {
  local resume_lanmouse=0 arg
  screen_require_omarchy || return 1
  for arg in "$@"; do
    case "$arg" in
      --resume-lanmouse|--resume-lan-mouse) resume_lanmouse=1 ;;
      -h|--help) cmd_screen_usage; return 0 ;;
      *) err "unknown screen on option: $arg"; cmd_screen_usage >&2; return 2 ;;
    esac
  done

  hyprctl dispatch dpms on >/dev/null
  ok "display power on requested"
  if [[ "$resume_lanmouse" -eq 1 ]]; then
    screen_lanmouse_action start
    ok "lan-mouse started"
  fi
}

cmd_screen_status() {
  screen_require_omarchy || return 1
  hyprctl monitors -j | jq -r '.[] | "\(.name): dpms=\(.dpmsStatus) disabled=\(.disabled) scale=\(.scale)"' 2>/dev/null || hyprctl monitors
  if command -v systemctl >/dev/null 2>&1 && systemd_user_ready; then
    printf 'lan-mouse.service: %s\n' "$(systemctl --user is-active lan-mouse.service 2>/dev/null || printf unavailable)"
  fi
  if command -v omarchy-shell >/dev/null 2>&1; then
    if [[ -e "${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/indicators/stay-awake" ]]; then
      printf 'Omarchy Stay Awake: on\n'
    else
      printf 'Omarchy Stay Awake: off\n'
    fi
  fi
}

cmd_screen() {
  local subcmd="${1:-status}"; shift || true
  case "$subcmd" in
    off) cmd_screen_off "$@" ;;
    on) cmd_screen_on "$@" ;;
    status) cmd_screen_status "$@" ;;
    help|-h|--help) cmd_screen_usage ;;
    *) err "unknown screen command: $subcmd"; cmd_screen_usage >&2; return 1 ;;
  esac
}

away_require_fornax() {
  if [[ "$(detect_os)" != "omarchy" || "$(detect_hostname)" != "fornax" ]]; then
    err "dotfiles away is only supported on fornax Omarchy systems"
    printf '  current: %s (%s)\n' "$(detect_hostname)" "$(detect_os)" >&2
    return 1
  fi
}

away_unit_active() {
  systemd_user_unit_active dotfiles-away-inhibit.service
}

cmd_away_status() {
  local root
  away_require_fornax || return 1
  printf 'Away mode: '
  if away_unit_active; then printf 'on\n'; else printf 'off\n'; fi
  printf 'OLED protection: %s\n' "$(oled_current_mode)"
  if command -v tailscale >/dev/null 2>&1; then
    printf 'Tailscale IPv4: %s\n' "$(tailscale ip -4 2>/dev/null | sed -n '1p')"
  fi
  if command -v systemctl >/dev/null 2>&1; then
    printf 'ollama.service: %s\n' "$(systemctl is-active ollama.service 2>/dev/null || printf unavailable)"
  fi
  if command -v ollama >/dev/null 2>&1; then
    if root="$(llm_local_ollama_url 2>/dev/null)"; then
      OLLAMA_HOST="$root" ollama ps 2>/dev/null || true
    else
      ollama ps 2>/dev/null || true
    fi
  fi
  if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi --query-gpu=temperature.gpu,memory.used,memory.total,power.draw --format=csv,nounits 2>/dev/null || true
  fi
  if command -v tmux >/dev/null 2>&1; then
    tmux list-sessions 2>/dev/null || true
  fi
}

cmd_away_usage() {
  cat <<'EOF'
Usage:
  dotfiles away on [--pause-lanmouse]
  dotfiles away off [--resume-lanmouse]
  dotfiles away status

Options:
  --pause-lanmouse    Stop lan-mouse after away mode is enabled so remote/edge
                      input cannot wake the OLED while you are away.
  --resume-lanmouse   Start lan-mouse after away mode is disabled.
EOF
}

cmd_away_on() {
  local pause_lanmouse=0 arg
  away_require_fornax || return 1
  for arg in "$@"; do
    case "$arg" in
      --pause-lanmouse|--pause-lan-mouse|--stop-lanmouse|--stop-lan-mouse|--no-lanmouse|--no-lan-mouse) pause_lanmouse=1 ;;
      -h|--help) cmd_away_usage; return 0 ;;
      *) err "unknown away on option: $arg"; cmd_away_usage >&2; return 2 ;;
    esac
  done
  cmd_oled on || return 1
  if ! systemd_user_ready; then
    err "user systemd manager is not reachable; log in again and rerun dotfiles apply"
    return 1
  fi
  if ! systemctl --user list-unit-files dotfiles-away-inhibit.service --no-legend 2>/dev/null | grep -q '^dotfiles-away-inhibit\.service'; then
    err "away inhibitor service is not installed; run: dotfiles apply"
    return 1
  fi
  systemctl --user start dotfiles-away-inhibit.service
  if ! command -v systemctl >/dev/null 2>&1 || ! systemctl is-active --quiet ollama.service 2>/dev/null; then
    warn "ollama.service is not active; run: dotfiles llm setup-host"
  fi
  command -v omarchy-system-lock >/dev/null 2>&1 && omarchy-system-lock >/dev/null 2>&1 || true
  command -v hyprctl >/dev/null 2>&1 && hyprctl dispatch dpms off >/dev/null 2>&1 || true
  if [[ "$pause_lanmouse" -eq 1 ]]; then
    screen_lanmouse_action stop
    ok "lan-mouse stopped"
  fi
  ok "fornax away mode enabled"
  cmd_away_status
}

cmd_away_off() {
  local resume_lanmouse=0 arg
  away_require_fornax || return 1
  for arg in "$@"; do
    case "$arg" in
      --resume-lanmouse|--resume-lan-mouse|--start-lanmouse|--start-lan-mouse) resume_lanmouse=1 ;;
      -h|--help) cmd_away_usage; return 0 ;;
      *) err "unknown away off option: $arg"; cmd_away_usage >&2; return 2 ;;
    esac
  done
  if systemd_user_ready; then
    systemctl --user stop dotfiles-away-inhibit.service >/dev/null 2>&1 || true
  fi
  cmd_oled off || return 1
  command -v hyprctl >/dev/null 2>&1 && hyprctl dispatch dpms on >/dev/null 2>&1 || true
  if [[ "$resume_lanmouse" -eq 1 ]]; then
    screen_lanmouse_action start
    ok "lan-mouse started"
  fi
  ok "fornax away mode disabled"
}

cmd_away() {
  local subcmd="${1:-status}"; shift || true
  case "$subcmd" in
    on) cmd_away_on "$@" ;;
    off) cmd_away_off "$@" ;;
    status) cmd_away_status "$@" ;;
    help|-h|--help) cmd_away_usage ;;
    *) err "unknown away command: $subcmd"; return 1 ;;
  esac
}

cmd_tailscale_policy() {
  local policy_cmd="$HOME/.local/bin/dotfiles-tailscale-policy"
  if [[ ! -x "$policy_cmd" ]]; then
    policy_cmd="$DOTFILES_DIR/stow/global/tailscale-policy/.local/bin/dotfiles-tailscale-policy"
  fi
  if [[ ! -x "$policy_cmd" ]]; then
    err "tailscale policy command not installed"
    printf '  run: dotfiles apply\n'
    return 1
  fi
  "$policy_cmd" "$@"
}

print_next_steps() {
  local os
  os="$(detect_os)"
  printf '\nNext steps:\n'
  if [[ "$os" == "macos" ]]; then
    print_macos_tailscale_next_step
    printf '  App Store: sign in so declared App Store apps (mas.txt) can install\n'
    printf '  macOS Accessibility: System Settings -> Privacy & Security -> Accessibility; enable AeroSpace, borders, Rectangle, Raycast, and LinearMouse\n'
    printf '    (AeroSpace/Rectangle shortcuts and LinearMouse scrolling do nothing until this is granted)\n'
    printf '  Raycast: Cmd-Space is preconfigured; if Spotlight still opens, log out and back in once\n'
    printf '  Finder toolbar: re-add AirDrop via Finder -> View -> Customize Toolbar (sidebar: Finder -> Settings -> Sidebar)\n'
  elif package_declared tailscale; then
    printf '  Tailscale login: sudo tailscale up\n'
  fi
  printf '  GitHub SSH: dotfiles git setup-ssh\n'
  printf '  Recovery pack: dotfiles recovery setup && dotfiles recovery send\n'
  printf '  Atuin: atuin login && atuin sync\n'
  printf '  Shell: open a new terminal or run exec zsh -l\n'
}

print_macos_tailscale_next_step() {
  local tailscale_cmd tailscaled_cmd
  package_declared_short tailscale || return 0
  tailscale_cmd="$(_tailscale_macos_cli)"
  tailscaled_cmd="$(_macos_tailscaled_cmd)"
  if [[ -d /Applications/Tailscale.app ]]; then
    printf '  Tailscale: delete /Applications/Tailscale.app, approve VPN profile removal, then rerun dotfiles update\n'
  elif [[ -z "$tailscale_cmd" ]]; then
    printf '  Tailscale: rerun dotfiles update to install the Homebrew tailscale formula\n'
  elif ! _macos_tailscale_daemon_installed; then
    if [[ -n "$tailscaled_cmd" ]]; then
      printf '  Tailscale: sudo "%s" install-system-daemon && tailscale up\n' "$tailscaled_cmd"
    else
      printf '  Tailscale: rerun dotfiles update to install tailscaled, then tailscale up\n'
    fi
  elif ! _macos_tailscale_daemon_running; then
    if [[ -n "$tailscaled_cmd" ]]; then
      printf '  Tailscale: sudo "%s" install-system-daemon && tailscale up\n' "$tailscaled_cmd"
    else
      printf '  Tailscale: rerun dotfiles update to repair tailscaled, then tailscale up\n'
    fi
  else
    printf '  Tailscale: tailscale up\n'
  fi
}

# SSH-session and legacy-layout checks that matter most on headless servers
# but are cheap and correct everywhere. Runbook: docs/server-minimal.md.
# shellcheck disable=SC2088  # literal ~/ in user-facing messages
_terminal_doctor() {
  local failed=0 link_target d name
  if [[ -L "$HOME/.ssh" ]]; then
    link_target="$(readlink "$HOME/.ssh")"
    [[ "$link_target" == /* ]] || link_target="$HOME/$link_target"
    case "$link_target" in
      "$DOTFILES_DIR"/*)
        err "~/.ssh is a symlink into the repo (legacy flat layout); key material there can be lost with the checkout"
        dim "  migrate it: rerun scripts/bootstrap.sh (moves keys into a real ~/.ssh; see docs/server-minimal.md)"
        failed=1
        ;;
    esac
  fi
  for d in "$DOTFILES_DIR"/stow/*/; do
    [[ -d "$d" ]] || continue
    name="$(basename "$d")"
    case "$name" in
      global|os-*|profile-*) ;;
      *) warn "legacy stow package leftover: stow/$name (old flat layout; review contents, rescue anything precious, then delete)" ;;
    esac
  done
  # Warn-only: TERM depends on whatever client is connected right now, so it
  # must never flip doctor to failing on an otherwise healthy machine.
  if [[ -n "${TERM:-}" && "$TERM" != dumb ]] && command -v infocmp >/dev/null 2>&1; then
    if infocmp "$TERM" >/dev/null 2>&1; then
      ok "terminfo present for TERM=$TERM"
    else
      warn "no terminfo for TERM=$TERM; zle redraw and full-screen apps (nano) will misbehave"
      dim "  from your local machine: infocmp -x \"$TERM\" | ssh $(detect_hostname) -- tic -x -"
      dim "  for this session: export TERM=xterm-256color"
      dim "  permanent client fix (Ghostty >= 1.2): shell-integration-features ssh-terminfo,ssh-env"
    fi
  fi
  return "$failed"
}

update_repo_safely() {
  local current_branch dirty choice default_branch
  dirty="$(git -C "$DOTFILES_DIR" status --porcelain)"
  if [[ -n "$dirty" ]]; then
    warn "repo has local changes; pull skipped until you choose how to handle them"
    git -C "$DOTFILES_DIR" status --short --branch
    printf '\nDiagnostics:\n  git status --short --branch\n  git diff --name-only\n\n'
    if ! have_tty; then
      warn "no TTY available; safe default is to stop before pulling"
      return 1
    fi
    printf 'Choose:\n  1) skip pull and continue package/stow update [recommended]\n  2) stash local changes, pull, then leave stash for manual review\n  3) reset local changes and pull [destructive]\nSelection [1]: ' >/dev/tty
    IFS= read -r choice </dev/tty || true
    case "${choice:-1}" in
      1) warn "skipping pull; continuing with current checkout"; return 0 ;;
      2)
        git -C "$DOTFILES_DIR" stash push -u -m "dotfiles update $(date +%Y-%m-%d-%H%M%S)"
        ;;
      3)
        if [[ "$(prompt_tty "Type yes to permanently reset local repo changes: ")" == "yes" ]]; then
          git -C "$DOTFILES_DIR" reset --hard
          git -C "$DOTFILES_DIR" clean -fd
        else
          warn "reset not confirmed; skipping pull"
          return 0
        fi
        ;;
      *) warn "unknown choice; skipping pull"; return 0 ;;
    esac
  fi

  current_branch="$(git -C "$DOTFILES_DIR" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [[ -z "$current_branch" ]]; then
    default_branch="$(git -C "$DOTFILES_DIR" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
    default_branch="${default_branch#origin/}"
    default_branch="${default_branch:-main}"
    warn "repo is in detached HEAD; switching to $default_branch before pulling"
    if git -C "$DOTFILES_DIR" show-ref --verify --quiet "refs/heads/$default_branch"; then
      git -C "$DOTFILES_DIR" switch "$default_branch"
    elif git -C "$DOTFILES_DIR" show-ref --verify --quiet "refs/remotes/origin/$default_branch"; then
      git -C "$DOTFILES_DIR" switch -c "$default_branch" "origin/$default_branch"
    else
      warn "cannot find origin/$default_branch; run: git -C '$DOTFILES_DIR' switch main"
      return 1
    fi
  fi

  if ! git -C "$DOTFILES_DIR" pull --ff-only; then
    warn "fast-forward failed; run: git status --short --branch && git diff --name-only"
    return 1
  fi
}

cmd_doctor() {
  local failed=0
  info "Doctor"
  for cmd in git stow bash curl zsh; do
    if command -v "$cmd" >/dev/null 2>&1; then
      ok "$cmd installed"
    else
      warn "$cmd missing"
      failed=1
    fi
  done

  local os host profile remote missing p
  os="$(detect_os)"; host="$(detect_hostname)"; profile="$(active_profile "$os" "$host")"
  if [[ -d "$DOTFILES_DIR/stow/$profile" ]]; then
    ok "profile exists: $profile"
  else
    warn "profile missing: $profile"
  fi
  case "$os" in
    omarchy)
      if [[ -f "$DOTFILES_DIR/packages/$profile/pacman.txt" ]]; then
        ok "profile pacman package list exists"
      else
        warn "profile pacman package list missing: packages/$profile/pacman.txt"
      fi
      if [[ -f "$DOTFILES_DIR/packages/$profile/aur.txt" ]]; then
        ok "profile AUR package list exists"
      else
        warn "profile AUR package list missing: packages/$profile/aur.txt"
      fi
      ;;
    debian|ubuntu)
      if [[ -f "$DOTFILES_DIR/packages/$profile/apt.txt" ]]; then
        ok "profile apt package list exists"
      else
        warn "profile apt package list missing: packages/$profile/apt.txt"
      fi
      ;;
    macos)
      if [[ -f "$DOTFILES_DIR/packages/$profile/brew.txt" ]]; then
        ok "profile brew package list exists"
      else
        warn "profile brew package list missing: packages/$profile/brew.txt"
      fi
      if [[ -f "$DOTFILES_DIR/packages/$profile/cask.txt" ]]; then
        ok "profile cask package list exists"
      else
        warn "profile cask package list missing: packages/$profile/cask.txt"
      fi
      ;;
  esac
  if command -v dotfiles >/dev/null 2>&1; then
    ok "dotfiles command in PATH"
  else
    warn "dotfiles command not in PATH"
  fi
  if [[ -r "$HOME/.oh-my-zsh/oh-my-zsh.sh" ]]; then
    ok "oh-my-zsh installed"
  else
    warn "oh-my-zsh missing at $HOME/.oh-my-zsh"
    failed=1
  fi
  for plugin in zsh-autosuggestions zsh-syntax-highlighting; do
    if [[ -d "$HOME/.oh-my-zsh/custom/plugins/$plugin" ]]; then
      ok "oh-my-zsh plugin installed: $plugin"
    else
      warn "oh-my-zsh plugin missing: $plugin"
      failed=1
    fi
  done
  if [[ -d "$HOME/.oh-my-zsh/custom/themes/powerlevel10k" || -d "$HOME/powerlevel10k" ]]; then
    ok "Powerlevel10k installed"
  else
    warn "Powerlevel10k missing; zsh prompt will fall back to robbyrussell"
    failed=1
  fi
  if [[ -f "$HOME/.p10k.zsh" ]]; then
    ok "Powerlevel10k config stowed"
  else
    warn "Powerlevel10k config missing at ~/.p10k.zsh"
  fi
  remote="$(git -C "$DOTFILES_DIR" remote get-url origin 2>/dev/null || true)"
  case "$remote" in
    git@github.com:*) ok "GitHub remote uses SSH" ;;
    https://github.com/*) warn "GitHub remote uses HTTPS; password auth does not work. Run: dotfiles git setup-ssh" ;;
    "") warn "Git remote origin not configured" ;;
    *) dim "  git remote: $remote" ;;
  esac

  info "Declared package health"
  validate_package_declarations || failed=1
  if [[ "$os" == "omarchy" ]] && aur_packages_declared; then
    local aur_health
    aur_health="$(paru_health_status 2>/dev/null || true)"
    case "$aur_health" in
      ready) ok "paru AUR helper ready" ;;
      missing) warn "AUR packages are declared but paru is missing"; failed=1 ;;
      broken:*) warn "paru installed but broken: ${aur_health#broken: }"; failed=1 ;;
    esac
  fi
  missing=0
  while read -r p; do
    [[ -z "$p" ]] && continue
    if ! _pkg_installed "$p"; then
      printf '  missing: %s\n' "$p"
      missing=$((missing+1))
    fi
  done < <(desired_packages)
  if [[ $missing -eq 0 ]]; then
    ok "all declared packages installed"
  else
    failed=1
  fi

  info "Terminal health"
  _terminal_doctor || failed=1

  info "Stow health"
  if apply_all_layers --no --verbose >/tmp/dotfiles-doctor-stow.$$ 2>&1; then
    ok "stow dry-run clean"
  else
    warn "stow dry-run found issues"
    sed 's/^/  /' /tmp/dotfiles-doctor-stow.$$ >&2
    failed=1
  fi
  rm -f /tmp/dotfiles-doctor-stow.$$

  if [[ "$(detect_os)" == "omarchy" ]]; then
    for cmd in ghostty brave firefox atuin zoxide yazi satty tailscale; do
      if command -v "$cmd" >/dev/null 2>&1; then
        ok "$cmd installed"
      else
        warn "$cmd missing"
        failed=1
      fi
    done
    if [[ -f "$HOME/.config/xdg-terminals.list" ]] && grep -q 'ghostty' "$HOME/.config/xdg-terminals.list"; then
      ok "terminal launcher prefers Ghostty"
    else
      warn "terminal launcher preference not stowed yet"
    fi
    if command -v hyprctl >/dev/null 2>&1; then
      if hyprctl configerrors >/dev/null 2>&1; then
        ok "Hyprland configerrors command ran"
      else
        warn "hyprctl configerrors failed"
      fi
      check_hypr_active_border || failed=1
    else
      warn "hyprctl missing or not available outside Hyprland"
    fi
    _lanmouse_doctor || failed=1
    if package_declared kdeconnect; then
      if systemd_user_unit_active kdeconnectd.service; then
        ok "kdeconnectd service active"
      else
        warn "kdeconnectd.service not active; run dotfiles update (or: systemctl --user restart kdeconnectd.service)"
        failed=1
      fi
      _kdeconnect_cli_doctor || failed=1
    fi
    _clipboard_notify_doctor || failed=1
    info "Wallpaper rotation"
    wallpaper_status_lines
  elif [[ "$(detect_os)" == "macos" ]]; then
    info "macOS apps and services"
    if command -v brew >/dev/null 2>&1; then
      ok "Homebrew installed"
      _macos_brew_prefix_doctor || failed=1
    else
      warn "Homebrew missing"; failed=1
    fi
    _macos_admin_doctor || failed=1
    if [[ "${BASH_VERSINFO[0]}" -ge 4 ]] || [[ -x /opt/homebrew/bin/bash || -x /usr/local/bin/bash ]]; then
      ok "bash >= 4 resolvable"
    else
      warn "bash >= 4 missing; run: brew install bash"; failed=1
    fi
    if command -v brew >/dev/null 2>&1 && brew list --cask --versions ghostty >/dev/null 2>&1; then
      ok "Ghostty cask installed"
    else
      warn "Ghostty cask missing"; failed=1
    fi
    _macos_app_doctor "AeroSpace" "/Applications/AeroSpace.app" || failed=1
    _macos_aerospace_doctor || failed=1
    _macos_app_doctor "Rectangle" "/Applications/Rectangle.app" || failed=1
    _macos_process_doctor Rectangle Rectangle || failed=1
    _macos_rectangle_doctor || failed=1
    _macos_app_doctor "Raycast" "/Applications/Raycast.app" || failed=1
    _macos_process_doctor Raycast Raycast || failed=1
    _macos_dotfiles_launchagent_doctor borders borders || failed=1
    _macos_dotfiles_launchagent_doctor linearmouse LinearMouse || failed=1
    if package_declared_short kde-connect; then
      _macos_dbus_session_doctor || failed=1
      _macos_dotfiles_launchagent_doctor kdeconnectd kdeconnectd || failed=1
      _kdeconnect_cli_doctor || failed=1
    fi
    _clipboard_notify_doctor || failed=1
    _macos_nerd_font_doctor || failed=1
    _macos_tailscale_doctor || failed=1
    _macos_ladomum_resolver_doctor || failed=1
    _macos_mas_doctor || failed=1
    _macos_dock_doctor || failed=1
    _macos_finder_doctor || failed=1
    _macos_input_doctor || failed=1
    _macos_wallpaper_launchagent_doctor || failed=1
    _lanmouse_doctor || failed=1
    info "Wallpaper rotation"
    wallpaper_status_lines
  fi
  return "$failed"
}

# --- status (aggregated) -------------------------------------------------
cmd_status() {
  local os host
  os="$(detect_os)"; host="$(detect_hostname)"

  info "Machine"
  printf '  hostname : %s\n  os       : %s\n  profile  : %s\n' "$host" "$os" "$(active_profile "$os" "$host")"

  info "Active layers"
  resolve_layers "$os" "$host" | sed 's/^/  /'

  if [[ -d "$DOTFILES_DIR/.git" ]]; then
    info "Repo"
    local branchline dirty remote
    branchline="$(git -C "$DOTFILES_DIR" status -sb | sed -n '1p')"
    dirty="$(git -C "$DOTFILES_DIR" status --porcelain | grep -c '' || true)"
    remote="$(git -C "$DOTFILES_DIR" remote get-url origin 2>/dev/null || true)"
    printf '  %s\n  dirty    : %s file(s)\n  remote   : %s\n' "$branchline" "$dirty" "${remote:-none}"
    [[ "$dirty" -gt 0 ]] && printf '  inspect  : git status --short --branch && git diff --name-only\n'
  fi

  info "Package drift"
  local mgr; mgr="$(pkg_manager)"
  if [[ -z "$mgr" ]]; then
    dim "  (no known package manager)"
  else
    local missing_count=0 p
    while read -r p; do
      [[ -z "$p" ]] && continue
      if ! _pkg_installed "$p"; then printf '  missing  : %s\n' "$p"; missing_count=$((missing_count+1)); fi
    done < <(desired_packages)
    [[ $missing_count -eq 0 ]] && ok "all declared packages installed"
  fi
  _aur_helper_status

  info "Sync tools"
  _tailscale_status
  _status_line "atuin"     'atuin status >/dev/null 2>&1'     "logged in" "not logged in"
  _status_line "syncthing" 'pgrep -x syncthing >/dev/null'    "running" "stopped"

  info "Terminal and apps"
  _command_status zsh
  _command_status dotfiles
  if [[ "$os" == "macos" ]]; then
    _macos_app_status "ghostty" "/Applications/Ghostty.app"
  else
    _command_status ghostty
  fi
  if [[ "$os" != "macos" ]]; then
    _command_status brave
  fi
  _command_status firefox
  if [[ -r "$HOME/.oh-my-zsh/oh-my-zsh.sh" ]]; then
    ok "oh-my-zsh installed"
  else
    warn "oh-my-zsh missing at $HOME/.oh-my-zsh"
  fi
  for plugin in zsh-autosuggestions zsh-syntax-highlighting; do
    if [[ -d "$HOME/.oh-my-zsh/custom/plugins/$plugin" ]]; then
      ok "oh-my-zsh plugin installed: $plugin"
    else
      warn "oh-my-zsh plugin missing: $plugin"
    fi
  done
  if [[ -d "$HOME/.oh-my-zsh/custom/themes/powerlevel10k" || -d "$HOME/powerlevel10k" ]]; then
    ok "Powerlevel10k installed"
  else
    warn "Powerlevel10k missing; zsh prompt will fall back to robbyrussell"
  fi
  if [[ -f "$HOME/.p10k.zsh" ]]; then
    ok "Powerlevel10k config stowed"
  else
    warn "Powerlevel10k config missing at ~/.p10k.zsh"
  fi

  info "Stow state"
  if apply_all_layers --no --verbose >/tmp/dotfiles-status-stow.$$ 2>&1; then
    ok "stow dry-run clean"
  else
    warn "stow dry-run reports conflicts or drift"
    sed 's/^/  /' /tmp/dotfiles-status-stow.$$ >&2
  fi
  rm -f /tmp/dotfiles-status-stow.$$

  info "Service state"
  case "$os" in
    omarchy)
      _tailscaled_daemon_status
      _lanmouse_status
      _kdeconnect_status
      _kdeconnect_devices_status
      _clipboard_notify_status
      _omarchy_shell_status
      ;;
    macos)
      _macos_aerospace_status
      _macos_process_status Raycast Raycast
      _macos_process_status Rectangle Rectangle
      _macos_rectangle_status
      _macos_dotfiles_launchagent_status borders borders
      _macos_dotfiles_launchagent_status linearmouse LinearMouse
      _macos_dbus_session_status
      _macos_dotfiles_launchagent_status kdeconnectd kdeconnectd
      _macos_ladomum_resolver_status
      _lanmouse_status
      _kdeconnect_devices_status
      _clipboard_notify_status
      _macos_dock_status
      _macos_finder_status
      _macos_input_status
      ;;
  esac
  if [[ "$os" == "omarchy" || "$os" == "macos" ]]; then
    info "Wallpaper rotation"
    wallpaper_status_lines
  fi

  recovery_status
}

# --- recovery pack -------------------------------------------------------
recovery_config_file() { printf '%s\n' "${DOTFILES_RECOVERY_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/recovery.local}"; }
recovery_state_dir() { printf '%s\n' "${DOTFILES_RECOVERY_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/recovery}"; }
recovery_output_dir() { printf '%s\n' "${RECOVERY_OUTPUT_DIR:-$HOME/recovery}"; }
recovery_age_identity() { printf '%s\n' "${RECOVERY_AGE_IDENTITY:-${XDG_CONFIG_HOME:-$HOME/.config}/age/recovery.txt}"; }

recovery_usage() {
  cat <<'EOF'
Usage:
  dotfiles recovery setup
  dotfiles recovery status
  dotfiles recovery build [--no-prompt]
  dotfiles recovery send [--if-due] [--no-prompt]
  dotfiles recovery verify <pack.age>
  dotfiles recovery install-timer [--days N]
  dotfiles recovery uninstall-timer

The pack is encrypted with AGE before it is emailed. Gmail sending uses an app
password stored only in ~/.config/dotfiles/recovery.local.
EOF
}

cmd_recovery() {
  local subcmd="${1:-status}"
  [[ $# -gt 0 ]] && shift || true
  case "$subcmd" in
    setup) recovery_setup "$@" ;;
    status) recovery_status ;;
    build) recovery_build_cmd "$@" ;;
    send) recovery_send_cmd "$@" ;;
    verify) recovery_verify_cmd "$@" ;;
    install-timer) recovery_install_timer "$@" ;;
    uninstall-timer) recovery_uninstall_timer ;;
    help|-h|--help) recovery_usage ;;
    *) err "unknown recovery subcommand: $subcmd"; recovery_usage; return 1 ;;
  esac
}

recovery_load_config() {
  local config
  config="$(recovery_config_file)"
  [[ -f "$config" ]] || return 1
  # shellcheck disable=SC1090
  . "$config"
}

recovery_secret_prompt() {
  local prompt="$1" ans
  have_tty || return 1
  printf '%s' "$prompt" >/dev/tty
  stty -echo </dev/tty
  IFS= read -r ans </dev/tty || true
  stty echo </dev/tty
  printf '\n' >/dev/tty
  printf '%s\n' "$ans"
}

recovery_setup() {
  local config config_dir age_dir identity recipient to from user password interval output_dir
  config="$(recovery_config_file)"
  config_dir="$(dirname "$config")"
  identity="$(recovery_age_identity)"
  age_dir="$(dirname "$identity")"

  have_tty || { err "recovery setup requires a TTY"; return 1; }
  command -v age-keygen >/dev/null 2>&1 || { err "age-keygen is required; install age first"; return 1; }

  mkdir -p "$config_dir" "$age_dir" "$(recovery_state_dir)" "$(recovery_output_dir)"
  chmod 700 "$config_dir" "$age_dir" "$(recovery_state_dir)" "$(recovery_output_dir)" 2>/dev/null || true

  if [[ -f "$identity" ]]; then
    ok "AGE recovery identity exists: $identity"
  elif confirm "Create AGE recovery identity at $identity?"; then
    age-keygen -o "$identity"
    chmod 600 "$identity"
  else
    err "AGE identity is required to decrypt recovery packs"
    return 1
  fi
  recipient="$(age-keygen -y "$identity")"

  printf '\nStore these securely outside this machine:\n'
  printf '  SECRET: %s (AGE private identity; required to decrypt packs)\n' "$identity"
  printf '  PUBLIC: %s (AGE recipient; safe to use for encryption)\n' "$recipient"
  printf '  SECRET: Gmail app password for the sending account\n\n'

  to="$(prompt_tty "Send recovery packs to email: ")"
  from="$(prompt_tty "Gmail from address [$to]: ")"; from="${from:-$to}"
  user="$(prompt_tty "Gmail SMTP username, usually full Gmail address [$from]: ")"; user="${user:-$from}"
  password="$(recovery_secret_prompt "Gmail app password (not your normal password): ")"
  interval="$(prompt_tty "Auto-send interval in days [30]: ")"; interval="${interval:-30}"
  output_dir="$(prompt_tty "Encrypted pack output directory [$(recovery_output_dir)]: ")"; output_dir="${output_dir:-$(recovery_output_dir)}"

  mkdir -p "$output_dir"
  chmod 700 "$output_dir" 2>/dev/null || true
  umask 077
  cat >"$config" <<EOF
# Local recovery-pack config. Contains secrets. Never commit.
RECOVERY_EMAIL_TO=$(printf '%q' "$to")
RECOVERY_EMAIL_FROM=$(printf '%q' "$from")
RECOVERY_SMTP_HOST=smtp.gmail.com
RECOVERY_SMTP_PORT=587
RECOVERY_SMTP_USER=$(printf '%q' "$user")
RECOVERY_SMTP_PASSWORD=$(printf '%q' "$password")
RECOVERY_AGE_RECIPIENT=$(printf '%q' "$recipient")
RECOVERY_AGE_IDENTITY=$(printf '%q' "$identity")
RECOVERY_OUTPUT_DIR=$(printf '%q' "$output_dir")
RECOVERY_SEND_INTERVAL_DAYS=$(printf '%q' "$interval")
EOF
  chmod 600 "$config"
  ok "wrote local recovery config: $config"
  warn "store $identity and the Gmail app password securely outside this machine"
}

recovery_require_config() {
  local config
  config="$(recovery_config_file)"
  if ! recovery_load_config; then
    err "recovery config missing: $config"
    printf '  run: dotfiles recovery setup\n' >&2
    return 1
  fi
  : "${RECOVERY_EMAIL_TO:?missing RECOVERY_EMAIL_TO in $config}"
  : "${RECOVERY_EMAIL_FROM:?missing RECOVERY_EMAIL_FROM in $config}"
  : "${RECOVERY_SMTP_USER:?missing RECOVERY_SMTP_USER in $config}"
  : "${RECOVERY_SMTP_PASSWORD:?missing RECOVERY_SMTP_PASSWORD in $config}"
  : "${RECOVERY_AGE_RECIPIENT:?missing RECOVERY_AGE_RECIPIENT in $config}"
}

recovery_set_config_value() {
  local key="$1" value="$2" config tmp quoted
  config="$(recovery_config_file)"
  [[ -f "$config" ]] || { err "recovery config missing: $config"; return 1; }
  quoted="$(printf '%q' "$value")"
  tmp="$(mktemp)"
  awk -v key="$key" -v value="$quoted" '
    BEGIN { done = 0 }
    $0 ~ "^" key "=" { print key "=" value; done = 1; next }
    { print }
    END { if (!done) print key "=" value }
  ' "$config" >"$tmp"
  cat "$tmp" >"$config"
  rm -f "$tmp"
  chmod 600 "$config"
}

recovery_status() {
  local config state last_pack last_sent age_days interval identity output_dir
  config="$(recovery_config_file)"
  state="$(recovery_state_dir)"
  identity="$(recovery_age_identity)"
  info "Recovery pack"
  printf '  config   : %s\n' "$config"
  if [[ -f "$config" ]]; then
    ok "local config present"
  else
    warn "local config missing; run: dotfiles recovery setup"
  fi
  if recovery_load_config; then
    output_dir="$(recovery_output_dir)"
    interval="${RECOVERY_SEND_INTERVAL_DAYS:-30}"
    printf '  email to : %s\n' "${RECOVERY_EMAIL_TO:-unset}"
    printf '  subject  : recovery pack from %s\n' "$(detect_hostname)"
    printf '  output   : %s\n' "$output_dir"
    printf '  interval : %s day(s)\n' "$interval"
    identity="${RECOVERY_AGE_IDENTITY:-$identity}"
  fi
  if [[ -f "$identity" ]]; then
    ok "AGE identity present: $identity"
  else
    warn "AGE identity missing: $identity"
  fi
  last_pack="$(sed -n '1p' "$state/last-pack" 2>/dev/null || true)"
  last_sent="$(sed -n '1p' "$state/last-sent" 2>/dev/null || true)"
  [[ -n "$last_pack" && -f "$last_pack" ]] && printf '  last pack: %s\n' "$last_pack" || printf '  last pack: none\n'
  if [[ -n "$last_sent" && -f "$last_sent" ]]; then
    age_days=$(( ( $(date +%s) - $(_mtime "$last_sent") ) / 86400 ))
    printf '  last sent: %s (%sd old)\n' "$last_sent" "$age_days"
  else
    printf '  last sent: none\n'
  fi
}

recovery_copy_if_exists() {
  local src="$1" dest_dir="$2" dest
  [[ -e "$src" ]] || return 0
  mkdir -p "$dest_dir"
  dest="$dest_dir/$(basename "$src")"
  if [[ -d "$src" ]]; then
    cp -pR "$src" "$dest_dir/"
  else
    cp -p "$src" "$dest"
  fi
  printf '%s\n' "$src" >>"$RECOVERY_MANIFEST"
}

recovery_collect_glob() {
  local dest_dir="$1" f
  shift
  for f in "$@"; do
    [[ -e "$f" ]] || continue
    recovery_copy_if_exists "$f" "$dest_dir"
  done
}

recovery_write_readme() {
  local pack="$1"
  cat >"$pack/README.txt" <<'EOF'
Recovery pack contents are secrets.

Restore SSH keys:
  mkdir -p ~/.ssh
  chmod 700 ~/.ssh
  cp -p ssh/id_* ~/.ssh/ 2>/dev/null || true
  cp -p ssh/config.local ~/.ssh/ 2>/dev/null || true
  chmod 600 ~/.ssh/id_* ~/.ssh/config.local 2>/dev/null || true
  chmod 644 ~/.ssh/*.pub 2>/dev/null || true

Restore service-specific credentials only on the machine that owns them.
Never commit this pack, extracted files, AGE identities, SMTP config, or logs.
EOF
}

recovery_collect_server_authorized_keys() {
  local pack="$1" host hosts=() line host_parts=() ssh_config
  ssh_config="$HOME/.ssh/config"
  [[ -r "$ssh_config" ]] || return 0
  while read -r line; do
    line="${line#Host }"
    [[ -n "$line" ]] || continue
    case "$line" in \**|*\**) continue ;; esac
    read -r -a host_parts <<<"$line"
    hosts+=("${host_parts[@]}")
  done < <(awk 'tolower($1) == "host" { $1=""; sub(/^ /, ""); print }' "$ssh_config")
  [[ ${#hosts[@]} -gt 0 ]] || return 0
  mkdir -p "$pack/servers"
  for host in "${hosts[@]}"; do
    [[ "$host" == github.com || "$host" == gitlab.com ]] && continue
    if ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" 'cat ~/.ssh/authorized_keys 2>/dev/null' >"$pack/servers/${host}-authorized_keys" 2>/dev/null; then
      printf 'server authorized_keys: %s\n' "$host" >>"$RECOVERY_MANIFEST"
    else
      rm -f "$pack/servers/${host}-authorized_keys"
      printf 'server authorized_keys unavailable: %s\n' "$host" >>"$RECOVERY_MANIFEST"
    fi
  done
}

recovery_add_manual_exports() {
  local pack="$1" ans path
  have_tty || return 0
  if ! confirm "Add manual export files or directories now?"; then
    return 0
  fi
  printf 'Enter one path per line. Empty line finishes.\n' >/dev/tty
  while true; do
    ans="$(prompt_tty "export path: ")"
    [[ -n "$ans" ]] || break
    path="${ans/#\~/$HOME}"
    if [[ -e "$path" ]]; then
      recovery_copy_if_exists "$path" "$pack/exports"
    else
      warn "not found: $path"
    fi
  done
}

recovery_build_cmd() {
  local no_prompt=0 arg pack_path
  for arg in "$@"; do
    case "$arg" in
      --no-prompt) no_prompt=1 ;;
      *) err "unknown recovery build option: $arg"; return 2 ;;
    esac
  done
  pack_path="$(recovery_build "$no_prompt")"
  printf '%s\n' "$pack_path"
}

recovery_build() {
  local no_prompt="$1" work pack stamp host output_dir out identity
  recovery_require_config || return 1
  command -v age >/dev/null 2>&1 || { err "age is required"; return 1; }
  command -v tar >/dev/null 2>&1 || { err "tar is required"; return 1; }

  host="$(detect_hostname)"
  stamp="$(date +%Y-%m-%d-%H%M%S)"
  output_dir="$(recovery_output_dir)"
  mkdir -p "$output_dir" "$(recovery_state_dir)"
  chmod 700 "$output_dir" "$(recovery_state_dir)" 2>/dev/null || true
  work="$(mktemp -d)"
  pack="$work/recovery-pack"
  mkdir -p "$pack/ssh" "$pack/exports" "$pack/local" "$pack/service-credentials"
  chmod 700 "$pack"
  RECOVERY_MANIFEST="$pack/MANIFEST.txt"
  export RECOVERY_MANIFEST
  printf 'created: %s\nhostname: %s\nos: %s\n\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$host" "$(detect_os)" >"$RECOVERY_MANIFEST"
  recovery_write_readme "$pack"

  recovery_collect_glob "$pack/ssh" "$HOME/.ssh"/id_* "$HOME/.ssh"/*.pub "$HOME/.ssh/authorized_keys" "$HOME/.ssh/config.local"
  recovery_copy_if_exists "$HOME/.config/lan-mouse/lan-mouse.pem" "$pack/service-credentials/lan-mouse"
  recovery_copy_if_exists "$HOME/.config/dotfiles/tailscale-networks.local" "$pack/service-credentials/dotfiles"
  recovery_copy_if_exists "$HOME/.config/gh/hosts.yml" "$pack/service-credentials/gh"
  recovery_copy_if_exists "$HOME/.kube/config" "$pack/service-credentials/kube"
  recovery_copy_if_exists "$HOME/.config/syncthing/cert.pem" "$pack/service-credentials/syncthing"
  recovery_copy_if_exists "$HOME/.config/syncthing/key.pem" "$pack/service-credentials/syncthing"
  recovery_copy_if_exists "$HOME/.config/syncthing/config.xml" "$pack/service-credentials/syncthing"
  recovery_copy_if_exists "$HOME/.config/kdeconnect" "$pack/service-credentials/kdeconnect"
  recovery_copy_if_exists "$HOME/.local/share/keyrings" "$pack/service-credentials/keyrings"
  recovery_copy_if_exists "$HOME/.local/share/atuin/key" "$pack/service-credentials/atuin"
  recovery_copy_if_exists "$HOME/.local/share/atuin/session" "$pack/service-credentials/atuin"
  recovery_copy_if_exists "$HOME/.local/share/atuin/history.db" "$pack/service-credentials/atuin"
  recovery_copy_if_exists "$HOME/.config/restic" "$pack/service-credentials/restic"
  recovery_copy_if_exists "$HOME/.config/rclone/rclone.conf" "$pack/service-credentials/rclone"
  recovery_copy_if_exists "$(recovery_config_file)" "$pack/local"
  identity="${RECOVERY_AGE_IDENTITY:-$(recovery_age_identity)}"
  if [[ -f "$identity" ]]; then
    printf 'AGE identity intentionally NOT included: %s\n' "$identity" >>"$RECOVERY_MANIFEST"
  fi
  recovery_collect_server_authorized_keys "$pack"
  [[ "$no_prompt" -eq 1 ]] || recovery_add_manual_exports "$pack"

  out="$output_dir/recovery-pack-${host}-${stamp}.tar.gz.age"
  tar -C "$work" -czf - recovery-pack | age -r "$RECOVERY_AGE_RECIPIENT" >"$out"
  chmod 600 "$out"
  rm -rf "$work"
  printf '%s\n' "$out" >"$(recovery_state_dir)/last-pack"
  printf '%s\n' "$out"
}

recovery_verify_cmd() {
  local pack="${1:-}" tmp identity
  [[ -n "$pack" ]] || { err "usage: dotfiles recovery verify <pack.age>"; return 2; }
  recovery_load_config || true
  identity="${RECOVERY_AGE_IDENTITY:-$(recovery_age_identity)}"
  [[ -f "$identity" ]] || { err "AGE identity missing: $identity"; return 1; }
  command -v age >/dev/null 2>&1 || { err "age is required"; return 1; }
  tmp="$(mktemp -d)"
  if age -d -i "$identity" "$pack" | tar -C "$tmp" -xzf -; then
    ok "pack decrypts: $pack"
    find "$tmp/recovery-pack" -maxdepth 3 -type f -print | sed 's|.*/recovery-pack/|  |'
    rm -rf "$tmp"
  else
    rm -rf "$tmp"
    err "pack verification failed"
    return 1
  fi
}

recovery_due() {
  local last_sent interval
  recovery_load_config || return 0
  interval="${RECOVERY_SEND_INTERVAL_DAYS:-30}"
  last_sent="$(sed -n '1p' "$(recovery_state_dir)/last-sent" 2>/dev/null || true)"
  [[ -n "$last_sent" && -f "$last_sent" ]] || return 0
  [[ $(( ( $(date +%s) - $(_mtime "$last_sent") ) / 86400 )) -ge "$interval" ]]
}

recovery_send_cmd() {
  local if_due=0 no_prompt=0 arg pack
  for arg in "$@"; do
    case "$arg" in
      --if-due) if_due=1 ;;
      --no-prompt) no_prompt=1 ;;
      *) err "unknown recovery send option: $arg"; return 2 ;;
    esac
  done
  if [[ "$if_due" -eq 1 ]] && ! recovery_due; then
    ok "recovery pack send skipped; interval has not elapsed"
    return 0
  fi
  pack="$(recovery_build "$no_prompt")"
  recovery_verify_cmd "$pack" >/dev/null
  recovery_send_email "$pack"
  printf '%s\n' "$pack" >"$(recovery_state_dir)/last-sent"
  ok "sent recovery pack: $pack"
}

recovery_send_email() {
  local pack="$1" msmtp_config boundary subject encoded_name body_file
  recovery_require_config || return 1
  command -v msmtp >/dev/null 2>&1 || { err "msmtp is required to send email"; return 1; }
  command -v base64 >/dev/null 2>&1 || { err "base64 is required to send email"; return 1; }
  subject="recovery pack from $(detect_hostname)"
  boundary="dotfiles-recovery-$(date +%s)-$$"
  encoded_name="$(basename "$pack")"
  msmtp_config="$(mktemp)"
  body_file="$(mktemp)"
  chmod 600 "$msmtp_config" "$body_file"
  cat >"$msmtp_config" <<EOF
defaults
auth on
tls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
account gmail
host ${RECOVERY_SMTP_HOST:-smtp.gmail.com}
port ${RECOVERY_SMTP_PORT:-587}
from $RECOVERY_EMAIL_FROM
user $RECOVERY_SMTP_USER
password $RECOVERY_SMTP_PASSWORD
account default : gmail
EOF
  if [[ "$(uname -s)" == "Darwin" ]]; then
    sed -i '' '/tls_trust_file/d' "$msmtp_config"
  fi
  {
    printf 'From: %s\n' "$RECOVERY_EMAIL_FROM"
    printf 'To: %s\n' "$RECOVERY_EMAIL_TO"
    printf 'Subject: %s\n' "$subject"
    printf 'MIME-Version: 1.0\n'
    printf 'Content-Type: multipart/mixed; boundary="%s"\n\n' "$boundary"
    printf -- '--%s\n' "$boundary"
    printf 'Content-Type: text/plain; charset=UTF-8\n\n'
    printf 'Encrypted AGE recovery pack from %s.\n\n' "$(detect_hostname)"
    printf 'Store the AGE identity and Gmail app password securely outside this machine.\n\n'
    printf -- '--%s\n' "$boundary"
    printf 'Content-Type: application/octet-stream; name="%s"\n' "$encoded_name"
    printf 'Content-Transfer-Encoding: base64\n'
    printf 'Content-Disposition: attachment; filename="%s"\n\n' "$encoded_name"
    base64 <"$pack"
    printf '\n--%s--\n' "$boundary"
  } >"$body_file"
  if msmtp --file="$msmtp_config" "$RECOVERY_EMAIL_TO" <"$body_file"; then
    rm -f "$msmtp_config" "$body_file"
  else
    rm -f "$msmtp_config" "$body_file"
    err "msmtp failed to send recovery email"
    return 1
  fi
}

recovery_install_timer() {
  local days="" service_dir launch_dir script log_dir label plist
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --days) shift; days="${1:-}" ;;
      --days=*) days="${1#--days=}" ;;
      *) err "unknown recovery install-timer option: $1"; return 2 ;;
    esac
    shift || true
  done
  if [[ -n "$days" && ! "$days" =~ ^[0-9]+$ ]]; then
    err "--days must be a positive integer"
    return 2
  fi
  if [[ -n "$days" ]]; then
    recovery_set_config_value RECOVERY_SEND_INTERVAL_DAYS "$days"
    RECOVERY_SEND_INTERVAL_DAYS="$days"
    ok "updated recovery send interval: $days day(s)"
  fi
  script="$(command -v dotfiles || printf '%s/scripts/dotfiles' "$DOTFILES_DIR")"
  if command -v systemctl >/dev/null 2>&1; then
    service_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    mkdir -p "$service_dir"
    cat >"$service_dir/dotfiles-recovery.service" <<EOF
[Unit]
Description=Build and email encrypted dotfiles recovery pack

[Service]
Type=oneshot
ExecStart=$script recovery send --if-due --no-prompt
EOF
    cat >"$service_dir/dotfiles-recovery.timer" <<'EOF'
[Unit]
Description=Daily dotfiles recovery due check

[Timer]
OnCalendar=daily
Persistent=true
Unit=dotfiles-recovery.service

[Install]
WantedBy=timers.target
EOF
    systemctl --user daemon-reload
    systemctl --user enable --now dotfiles-recovery.timer
    ok "installed systemd user timer: dotfiles-recovery.timer"
  elif command -v launchctl >/dev/null 2>&1; then
    launch_dir="$HOME/Library/LaunchAgents"
    log_dir="$HOME/Library/Logs/dotfiles"
    mkdir -p "$launch_dir" "$log_dir"
    label="com.francolopez.dotfiles.recovery"
    plist="$launch_dir/$label.plist"
    cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array>
    <string>$script</string><string>recovery</string><string>send</string><string>--if-due</string><string>--no-prompt</string>
  </array>
  <key>StartInterval</key><integer>86400</integer>
  <key>StandardOutPath</key><string>$log_dir/recovery.out.log</string>
  <key>StandardErrorPath</key><string>$log_dir/recovery.err.log</string>
</dict></plist>
EOF
    launchctl unload "$plist" >/dev/null 2>&1 || true
    launchctl load "$plist"
    ok "installed LaunchAgent: $plist"
  else
    err "no supported scheduler found (systemd user or launchctl)"
    return 1
  fi
}

recovery_uninstall_timer() {
  local label plist
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user disable --now dotfiles-recovery.timer 2>/dev/null || true
    rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/dotfiles-recovery.service" \
      "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/dotfiles-recovery.timer"
    systemctl --user daemon-reload 2>/dev/null || true
    ok "removed systemd recovery timer"
  fi
  if command -v launchctl >/dev/null 2>&1; then
    label="com.francolopez.dotfiles.recovery"
    plist="$HOME/Library/LaunchAgents/$label.plist"
    launchctl unload "$plist" >/dev/null 2>&1 || true
    rm -f "$plist"
    ok "removed LaunchAgent recovery timer"
  fi
}

cmd_git() {
  local subcmd="${1:-}" remote
  case "$subcmd" in
    setup-ssh)
      info "GitHub SSH setup"
      printf '  1. Create a key if needed:\n'
      printf '     ssh-keygen -t ed25519 -C "email@gmail.com"\n'
      printf '  2. Copy the public key:\n'
      printf '     cat ~/.ssh/id_ed25519.pub\n'
      printf '  3. Add it in GitHub: Settings -> SSH and GPG keys -> New SSH key\n'
      printf '  4. Test auth:\n'
      printf '     ssh -T git@github.com\n'
      remote="$(git -C "$DOTFILES_DIR" remote get-url origin 2>/dev/null || true)"
      if [[ "$remote" == git@github.com:* ]]; then
        ok "origin already uses SSH: $remote"
      elif [[ "$remote" == https://github.com/* ]]; then
        printf '\nCurrent origin: %s\n' "$remote"
        if confirm "Switch origin to git@github.com:jfrancolopez/dotfiles.git now?"; then
          git -C "$DOTFILES_DIR" remote set-url origin git@github.com:jfrancolopez/dotfiles.git
          ok "origin switched to SSH"
        else
          printf '  later: git -C %q remote set-url origin git@github.com:jfrancolopez/dotfiles.git\n' "$DOTFILES_DIR"
        fi
      else
        warn "origin is not the expected GitHub HTTPS remote: ${remote:-none}"
      fi
      ;;
    help|-h|--help|"")
      printf 'Usage: dotfiles git setup-ssh\n'
      ;;
    *) err "unknown git subcommand: $subcmd"; return 1 ;;
  esac
}

commands_registry_file() {
  local repo_file="$DOTFILES_DIR/stow/global/discovery/.config/dotfiles/commands.tsv"
  local home_file="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/commands.tsv"
  if [[ -f "$repo_file" ]]; then
    printf '%s\n' "$repo_file"
  else
    printf '%s\n' "$home_file"
  fi
}

cmd_commands() {
  local subcmd="${1:-list}"
  [[ $# -gt 0 ]] && shift || true
  case "$subcmd" in
    list) commands_list "$@" ;;
    search) commands_search "$@" ;;
    doctor) commands_doctor ;;
    help|-h|--help)
      printf 'Usage:\n  dotfiles commands list [--menu]\n  dotfiles commands search <query>\n  dotfiles commands doctor\n'
      ;;
    *) err "unknown commands subcommand: $subcmd"; return 1 ;;
  esac
}

commands_list() {
  local registry menu=0
  registry="$(commands_registry_file)"
  [[ "${1:-}" == "--menu" ]] && menu=1
  [[ -f "$registry" ]] || { err "commands registry not found: $registry"; return 1; }
  if [[ $menu -eq 1 ]]; then
    awk -F '\t' 'NR > 1 && NF >= 9 { printf "%-34s %-24s %s\n", $4, $5, $7 }' "$registry"
  else
    awk -F '\t' '
      NR == 1 { next }
      NF >= 9 {
        printf "%s\n  %s\n  %s\n", $4, ($5 != "" ? $5 : $6), $7
      }' "$registry"
  fi
}

commands_search() {
  local registry query
  registry="$(commands_registry_file)"
  query="$*"
  [[ -n "$query" ]] || { err "usage: dotfiles commands search <query>"; return 2; }
  [[ -f "$registry" ]] || { err "commands registry not found: $registry"; return 1; }
  awk -F '\t' -v query="$query" '
    BEGIN { q = tolower(query); found = 0 }
    NR == 1 { next }
    NF >= 9 {
      haystack = tolower($1 " " $2 " " $3 " " $4 " " $5 " " $6 " " $7 " " $8)
      if (index(haystack, q) > 0) {
        printf "%s\n  %s\n  %s\n", $4, ($5 != "" ? $5 : $6), $7
        found = 1
      }
    }
    END { exit found ? 0 : 1 }' "$registry"
}

commands_doctor() {
  local registry failed=0 expected_header source id duplicate
  registry="$(commands_registry_file)"
  expected_header=$'id\tscope\ttype\ttitle\ttrigger\tcommand\tdescription\tkeywords\tsource'
  info "Commands registry"
  [[ -f "$registry" ]] || { err "commands registry not found: $registry"; return 1; }
  if [[ "$(sed -n '1p' "$registry")" == "$expected_header" ]]; then
    ok "header valid"
  else
    warn "header does not match expected TSV schema"
    failed=1
  fi
  if awk -F '\t' 'NR > 1 && NF != 9 { printf "line %d has %d fields\n", NR, NF; bad = 1 } END { exit bad ? 1 : 0 }' "$registry"; then
    ok "field counts valid"
  else
    failed=1
  fi
  duplicate="$(awk -F '\t' 'NR > 1 { count[$1]++ } END { for (id in count) if (count[id] > 1) print id }' "$registry")"
  if [[ -z "$duplicate" ]]; then
    ok "ids unique"
  else
    warn "duplicate ids: $duplicate"
    failed=1
  fi
  while IFS=$'\t' read -r id _scope _type _title _trigger _command _description _keywords source; do
    [[ "$id" == "id" ]] && continue
    [[ -n "$source" ]] || { warn "missing source for $id"; failed=1; continue; }
    [[ -e "$DOTFILES_DIR/$source" ]] || { warn "missing source for $id: $source"; failed=1; }
  done <"$registry"
  [[ $failed -eq 0 ]] && ok "source paths valid"
  return "$failed"
}

_command_status() {
  local cmd="$1"
  command -v "$cmd" >/dev/null 2>&1 && printf '  %s: installed\n' "$cmd" || printf '  %s: missing\n' "$cmd"
}

_systemd_status() {
  local unit="$1"
  command -v systemctl >/dev/null 2>&1 || return 0
  systemctl is-active --quiet "$unit" 2>/dev/null && printf '  %s: active\n' "$unit" || printf '  %s: inactive/unknown\n' "$unit"
}

_systemd_user_status() {
  local unit="$1"
  command -v systemctl >/dev/null 2>&1 || return 0
  systemctl --user is-active --quiet "$unit" 2>/dev/null && printf '  %s: active\n' "$unit" || printf '  %s: inactive/unknown\n' "$unit"
}

package_declared() {
  local pkg="$1" declared
  while read -r declared; do
    [[ "$declared" == "$pkg" ]] && return 0
  done < <(desired_packages)
  return 1
}

package_declared_short() {
  local pkg="$1" declared
  while read -r declared; do
    [[ "${declared##*/}" == "$pkg" ]] && return 0
  done < <(desired_packages)
  return 1
}

_aur_helper_status() {
  [[ "$(detect_os)" == "omarchy" ]] || return 0
  aur_packages_declared || return 0
  local health
  health="$(paru_health_status 2>/dev/null || true)"
  case "$health" in
    ready) ok "AUR helper ready: paru" ;;
    missing) printf '  AUR helper: missing\n' ;;
    broken:*) warn "AUR helper broken: ${health#broken: }" ;;
  esac
}

# --- lan-mouse (KVM sharing) helpers --------------------------------------
# Only machines whose layers stow a peer config report on lan-mouse.
_lanmouse_configured() { [[ -e "$HOME/.config/lan-mouse/config.toml" ]]; }

_lanmouse_cert_fingerprint() {
  local pem="$HOME/.config/lan-mouse/lan-mouse.pem"
  [[ -r "$pem" ]] || return 1
  command -v openssl >/dev/null 2>&1 || return 1
  openssl x509 -in "$pem" -noout -fingerprint -sha256 2>/dev/null |
    sed 's/^.*=//' | tr '[:upper:]' '[:lower:]'
}

_lanmouse_doctor() {
  _lanmouse_configured || return 0
  local failed=0 fp
  info "KVM sharing (lan-mouse)"
  case "$(detect_os)" in
    omarchy)
      if [[ "$(_omarchy_lanmouse_installed_version)" == "$_LANMOUSE_VERSION" ]]; then
        ok "lan-mouse $_LANMOUSE_VERSION installed (dotfiles-pinned)"
      else
        warn "dotfiles-pinned lan-mouse $_LANMOUSE_VERSION missing at $(_omarchy_lanmouse_bin); run dotfiles update"
        failed=1
      fi
      if systemd_user_unit_active lan-mouse.service; then
        ok "lan-mouse service active"
      else
        warn "lan-mouse.service not active; run dotfiles update (or: systemctl --user restart lan-mouse.service)"
        failed=1
      fi
      ;;
    macos)
      _macos_app_doctor "Lan Mouse" "/Applications/Lan Mouse.app" || return 1
      _macos_dotfiles_launchagent_doctor lanmouse lan-mouse || failed=1
      _macos_lanmouse_accessibility_hint
      ;;
  esac
  if fp="$(_lanmouse_cert_fingerprint)"; then
    printf '  this machine fingerprint: %s\n' "$fp"
    dim "  authorize it on each peer profile config: stow/profile-*/lan-mouse (docs/kvm-sharing.md)"
  else
    dim "  no TLS certificate yet; it is generated on first daemon start"
  fi
  return "$failed"
}

_lanmouse_status() {
  _lanmouse_configured || return 0
  if pgrep -x lan-mouse >/dev/null 2>&1; then
    printf '  lan-mouse (KVM): running\n'
  else
    printf '  lan-mouse (KVM): not running\n'
    printf '  next step: dotfiles update\n'
  fi
}

_kdeconnect_status() {
  package_declared kdeconnect || return 0
  if pgrep -x kdeconnectd >/dev/null 2>&1; then
    printf '  kdeconnect (clipboard): running\n'
  else
    printf '  kdeconnect (clipboard): not running\n'
    printf '  next step: dotfiles update\n'
  fi
}

_kdeconnect_declared() {
  case "$(detect_os)" in
    macos) package_declared_short kde-connect ;;
    omarchy) package_declared kdeconnect ;;
    *) return 1 ;;
  esac
}

_kdeconnect_cli_bin() {
  if [[ "$(detect_os)" == "macos" && -x "/Applications/KDE Connect.app/Contents/MacOS/kdeconnect-cli" ]]; then
    printf '%s\n' "/Applications/KDE Connect.app/Contents/MacOS/kdeconnect-cli"
  elif command -v kdeconnect-cli >/dev/null 2>&1; then
    command -v kdeconnect-cli
  else
    return 1
  fi
}

_kdeconnect_cli_doctor() {
  _kdeconnect_declared || return 0
  local cli output err_file first
  if ! cli="$(_kdeconnect_cli_bin)"; then
    warn "kdeconnect-cli missing; reinstall KDE Connect"
    return 1
  fi
  err_file="$(mktemp)"
  if output="$("$cli" --list-available --id-name-only 2>"$err_file")"; then
    if [[ -n "$output" ]]; then
      first="$(printf '%s\n' "$output" | sed -n '1p')"
      ok "KDE Connect reachable device: $first"
      rm -f "$err_file"
      return 0
    fi
    warn "KDE Connect has no paired reachable devices"
    warn "open KDE Connect, pair the peer, and enable the Clipboard plugin on both sides"
    rm -f "$err_file"
    return 1
  fi
  first="$(sed -n '1p' "$err_file" 2>/dev/null || true)"
  rm -f "$err_file"
  warn "KDE Connect CLI failed: ${first:-unknown error}"
  if [[ "$(detect_os)" == "macos" ]] && ! _macos_dbus_session_loaded; then
    warn "D-Bus session bus is not loaded; run: dotfiles update"
  fi
  return 1
}

_kdeconnect_devices_status() {
  _kdeconnect_declared || return 0
  local cli output first
  if ! cli="$(_kdeconnect_cli_bin)"; then
    printf '  kdeconnect devices: kdeconnect-cli missing\n'
    return 0
  fi
  if output="$("$cli" --list-available --id-name-only 2>/dev/null)"; then
    if [[ -n "$output" ]]; then
      first="$(printf '%s\n' "$output" | sed -n '1p')"
      printf '  kdeconnect devices: reachable (%s)\n' "$first"
    else
      printf '  kdeconnect devices: none reachable\n'
      printf '  next step: pair devices and enable the Clipboard plugin\n'
    fi
  else
    printf '  kdeconnect devices: CLI unavailable\n'
    if [[ "$(detect_os)" == "macos" ]] && ! _macos_dbus_session_loaded; then
      printf '  next step: dotfiles update\n'
    fi
  fi
}

_clipboard_notify_doctor() {
  case "$(detect_os)" in
    omarchy)
      local failed=0
      command -v wl-paste >/dev/null 2>&1 || { warn "wl-paste missing; install wl-clipboard"; failed=1; }
      command -v notify-send >/dev/null 2>&1 || { warn "notify-send missing; install libnotify"; failed=1; }
      if systemd_user_unit_active dotfiles-clipboard-notify.service; then
        ok "clipboard notification service active"
      else
        warn "dotfiles-clipboard-notify.service not active; run dotfiles update"
        failed=1
      fi
      return "$failed"
      ;;
    macos)
      command -v terminal-notifier >/dev/null 2>&1 || warn "terminal-notifier missing; clipboard notifications will use osascript fallback"
      _macos_dotfiles_launchagent_doctor clipboard-notify "dotfiles-clipboard-notify watch"
      ;;
  esac
}

_clipboard_notify_status() {
  case "$(detect_os)" in
    omarchy)
      if systemd_user_unit_active dotfiles-clipboard-notify.service; then
        printf '  clipboard notifications: active\n'
      elif systemd_user_unit_exists dotfiles-clipboard-notify.service; then
        printf '  clipboard notifications: installed, inactive\n'
        printf '  next step: dotfiles update\n'
      else
        printf '  clipboard notifications: service not installed\n'
      fi
      ;;
    macos)
      _macos_dotfiles_launchagent_status clipboard-notify "dotfiles-clipboard-notify watch"
      ;;
  esac
}

_tailscaled_daemon_status() {
  if ! command -v systemctl >/dev/null 2>&1; then
    return 0
  fi
  if ! package_declared tailscale && ! command -v tailscale >/dev/null 2>&1; then
    return 0
  fi
  if systemctl is-active --quiet tailscaled.service 2>/dev/null; then
    printf '  tailscaled daemon: running\n'
  else
    printf '  tailscaled daemon: not running\n'
    printf '  next step: sudo systemctl enable --now tailscaled.service\n'
  fi
}

_tailscale_status() {
  local tailscale_cmd=""
  if [[ "$(detect_os)" == "macos" ]]; then
    tailscale_cmd="$(_tailscale_macos_cli)"
    if [[ -z "$tailscale_cmd" ]]; then
      if package_declared_short tailscale; then
        dim "  tailscale: not installed"
        printf '  next step: dotfiles update\n'
      else
        dim "  tailscale: not declared"
      fi
      return 0
    fi
    if package_declared_short tailscale; then
      if [[ -d /Applications/Tailscale.app ]]; then
        warn "  tailscale: Tailscale.app installed; remove it before Homebrew daemon migration"
        printf '  next step: delete /Applications/Tailscale.app, approve VPN profile removal, then rerun dotfiles update\n'
        return 0
      elif _macos_tailscale_daemon_running; then
        printf '  tailscaled daemon: running\n'
      elif _macos_tailscale_daemon_installed; then
        printf '  tailscaled daemon: installed, not running\n'
        printf '  next step: sudo "%s" install-system-daemon\n' "$(_macos_tailscaled_cmd)"
      else
        printf '  tailscaled daemon: not installed\n'
        printf '  next step: sudo "%s" install-system-daemon\n' "$(_macos_tailscaled_cmd)"
        return 0
      fi
    fi
    if "$tailscale_cmd" status >/dev/null 2>&1; then
      printf '  tailscale login: connected\n'
    else
      printf '  tailscale login: not connected\n'
      printf '  next step: tailscale up\n'
    fi
    return 0
  fi
  if ! command -v tailscale >/dev/null 2>&1; then
    dim "  tailscale login: not installed"
  elif tailscale status >/dev/null 2>&1; then
    printf '  tailscale login: connected\n'
  else
    printf '  tailscale login: not connected\n'
    printf '  next step: sudo tailscale up\n'
  fi
}

_tailscale_macos_cli() {
  if command -v tailscale >/dev/null 2>&1; then
    command -v tailscale
  elif [[ -x "$(_macos_brew_prefix)/bin/tailscale" ]]; then
    printf '%s\n' "$(_macos_brew_prefix)/bin/tailscale"
  elif [[ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]]; then
    printf '%s\n' /Applications/Tailscale.app/Contents/MacOS/Tailscale
  fi
}

_macos_tailscaled_cmd() {
  if command -v tailscaled >/dev/null 2>&1; then
    command -v tailscaled
  elif [[ -x "$(_macos_brew_prefix)/bin/tailscaled" ]]; then
    printf '%s\n' "$(_macos_brew_prefix)/bin/tailscaled"
  fi
}

_macos_tailscale_daemon_installed() {
  launchctl print system/com.tailscale.tailscaled >/dev/null 2>&1 ||
    [[ -f /Library/LaunchDaemons/com.tailscale.tailscaled.plist ]]
}

_macos_tailscale_daemon_running() {
  launchctl print system/com.tailscale.tailscaled 2>/dev/null | grep -q 'state = running'
}

_macos_tailscale_doctor() {
  local tailscale_cmd tailscaled_cmd
  package_declared_short tailscale || return 0
  tailscale_cmd="$(_tailscale_macos_cli)"
  tailscaled_cmd="$(_macos_tailscaled_cmd)"
  if [[ -z "$tailscale_cmd" || -z "$tailscaled_cmd" ]]; then
    warn "Tailscale formula missing; run dotfiles update"
    return 1
  fi
  ok "Tailscale formula installed"
  if [[ -d /Applications/Tailscale.app ]]; then
    warn "Tailscale.app is installed; remove it before enabling the Homebrew tailscaled daemon"
    return 1
  fi
  if ! _macos_tailscale_daemon_installed; then
    warn "Tailscale system daemon missing; run: sudo \"$tailscaled_cmd\" install-system-daemon"
    return 1
  fi
  if _macos_tailscale_daemon_running; then
    ok "Tailscale system daemon running"
  else
    warn "Tailscale system daemon installed but not running; run: sudo \"$tailscaled_cmd\" install-system-daemon"
    return 1
  fi
}

_macos_ladomum_resolver_source() {
  local source_file
  source_file="$HOME/.local/share/dotfiles/resolver/ladomum.com"
  if [[ -r "$source_file" ]]; then
    printf '%s\n' "$source_file"
  else
    printf '%s\n' "$DOTFILES_DIR/stow/os-macos/resolver/.local/share/dotfiles/resolver/ladomum.com"
  fi
}

_macos_ladomum_resolver_target() {
  printf '/etc/resolver/ladomum.com\n'
}

_macos_ladomum_resolver_installed() {
  local source_file target_file
  source_file="$(_macos_ladomum_resolver_source)"
  target_file="$(_macos_ladomum_resolver_target)"
  [[ -r "$source_file" && -r "$target_file" ]] && cmp -s "$source_file" "$target_file"
}

_macos_ladomum_resolver_doctor() {
  if _macos_ladomum_resolver_installed; then
    ok "ladomum.com resolver installed"
  else
    warn "ladomum.com resolver missing or drifted; run: dotfiles update"
    return 1
  fi
}

_macos_ladomum_resolver_status() {
  if _macos_ladomum_resolver_installed; then
    printf '  ladomum.com resolver: installed\n'
  else
    printf '  ladomum.com resolver: missing or drifted\n'
    printf '  next step: dotfiles update\n'
  fi
}

_macos_app_doctor() {
  local name="$1" path="$2"
  if [[ -d "$path" ]]; then
    ok "$name installed"
  else
    warn "$name missing at $path"
    return 1
  fi
}

_macos_process_doctor() {
  local name="$1" process="$2"
  if _macos_process_running "$process"; then
    ok "$name running"
  else
    warn "$name not running; run dotfiles update or open /Applications/$name.app"
    return 1
  fi
}

_macos_process_status() {
  local name="$1" process="$2"
  if _macos_process_running "$process"; then
    printf '  %s: running\n' "$name"
  elif [[ -d "/Applications/$name.app" ]]; then
    printf '  %s: installed, not running\n' "$name"
  else
    printf '  %s: missing\n' "$name"
  fi
}

_macos_process_running() {
  local process="$1"
  case "$process" in
    *' '*|*/*) pgrep -f "$process" >/dev/null 2>&1 ;;
    *) pgrep -x "$process" >/dev/null 2>&1 ;;
  esac
}

_macos_dotfiles_launchagent_label() {
  printf 'com.dotfiles.%s\n' "$1"
}

_macos_dotfiles_launchagent_file() {
  printf '%s/Library/LaunchAgents/%s.plist\n' "$HOME" "$(_macos_dotfiles_launchagent_label "$1")"
}

_macos_dotfiles_launchagent_log() {
  printf '%s/Library/Logs/dotfiles/%s.err.log\n' "$HOME" "$1"
}

_macos_dbus_session_loaded() {
  local uid
  uid="$(id -u)"
  launchctl print "gui/$uid/org.freedesktop.dbus-session" >/dev/null 2>&1
}

_macos_dbus_session_doctor() {
  if _macos_dbus_session_loaded; then
    ok "D-Bus session LaunchAgent loaded"
  else
    warn "D-Bus session LaunchAgent not loaded; KDE Connect clipboard sync will fail"
    warn "run: dotfiles update"
    return 1
  fi
}

_macos_dbus_session_status() {
  if _macos_dbus_session_loaded; then
    printf '  dbus session: loaded\n'
  else
    printf '  dbus session: not loaded\n'
    printf '  next step: dotfiles update\n'
  fi
}

_macos_dotfiles_launchagent_loaded() {
  local service="$1" uid label
  uid="$(id -u)"
  label="$(_macos_dotfiles_launchagent_label "$service")"
  launchctl print "gui/$uid/$label" >/dev/null 2>&1
}

_macos_dotfiles_launchagent_running() {
  local service="$1" process="$2"
  _macos_dotfiles_launchagent_loaded "$service" && _macos_process_running "$process"
}

_macos_dotfiles_launchagent_background_blocked() {
  local service="$1" label btm_id
  command -v sfltool >/dev/null 2>&1 || return 1
  label="$(_macos_dotfiles_launchagent_label "$service")"
  btm_id="8.$label"
  sfltool dumpbtm 2>/dev/null | awk -v id="$btm_id" '
    /^ #[0-9]+:/ { disposition = ""; found = 0 }
    $1 == "Disposition:" { disposition = $0 }
    $1 == "Identifier:" && $2 == id {
      found = 1
      if (disposition ~ /disallowed/) blocked = 1
      next
    }
    found && $1 == "Disposition:" {
      if ($0 ~ /disallowed/) blocked = 1
      found = 0
    }
    END { exit blocked ? 0 : 1 }
  '
}

_macos_dotfiles_launchagent_background_hint() {
  local service="$1"
  warn "macOS Background Items is blocking $service at login"
  warn "enable the Unknown Developer/bash item in System Settings -> General -> Login Items & Extensions"
}

_macos_dotfiles_launchagent_log_hint() {
  local service="$1" log
  log="$(_macos_dotfiles_launchagent_log "$service")"
  warn "inspect service log: $log"
  if [[ -s "$log" ]]; then
    tail -n 12 "$log" 2>/dev/null | sed 's/^/  /' >&2 || true
  fi
}

_macos_dotfiles_launchagent_doctor() {
  local service="$1" process="$2"
  if _macos_dotfiles_launchagent_running "$service" "$process"; then
    ok "dotfiles LaunchAgent running: $service"
    if _macos_dotfiles_launchagent_background_blocked "$service"; then
      _macos_dotfiles_launchagent_background_hint "$service"
      return 1
    fi
  elif _macos_dotfiles_launchagent_loaded "$service"; then
    warn "dotfiles LaunchAgent loaded but process is not running: $service"
    if _macos_dotfiles_launchagent_background_blocked "$service"; then
      _macos_dotfiles_launchagent_background_hint "$service"
    fi
    _macos_dotfiles_launchagent_log_hint "$service"
    return 1
  else
    warn "dotfiles LaunchAgent not loaded: $service"
    if _macos_dotfiles_launchagent_background_blocked "$service"; then
      _macos_dotfiles_launchagent_background_hint "$service"
    fi
    _macos_dotfiles_launchagent_log_hint "$service"
    return 1
  fi
}

_macos_dotfiles_launchagent_status() {
  local service="$1" process="$2" file
  file="$(_macos_dotfiles_launchagent_file "$service")"
  if _macos_dotfiles_launchagent_running "$service" "$process"; then
    printf '  %s: dotfiles LaunchAgent running (%s)\n' "$service" "$file"
    if _macos_dotfiles_launchagent_background_blocked "$service"; then
      printf '  %s warning: macOS Background Items is blocking launch at next login\n' "$service"
      printf '  %s fix: enable Unknown Developer/bash in Login Items & Extensions\n' "$service"
    fi
  elif _macos_dotfiles_launchagent_loaded "$service"; then
    printf '  %s: dotfiles LaunchAgent loaded, process not running (%s)\n' "$service" "$file"
    printf '  %s log: %s\n' "$service" "$(_macos_dotfiles_launchagent_log "$service")"
    if _macos_dotfiles_launchagent_background_blocked "$service"; then
      printf '  %s warning: macOS Background Items is blocking launch at next login\n' "$service"
      printf '  %s fix: enable Unknown Developer/bash in Login Items & Extensions\n' "$service"
    fi
  elif [[ -f "$file" ]]; then
    printf '  %s: dotfiles LaunchAgent installed, not loaded (%s)\n' "$service" "$file"
    if _macos_dotfiles_launchagent_background_blocked "$service"; then
      printf '  %s warning: macOS Background Items is blocking this LaunchAgent\n' "$service"
      printf '  %s fix: enable Unknown Developer/bash in Login Items & Extensions, then run dotfiles update\n' "$service"
    fi
  else
    printf '  %s: dotfiles LaunchAgent not installed\n' "$service"
  fi
}

_macos_brew_service_started() {
  local service="$1" line
  line="$(_macos_brew_service_line "$service")"
  if [[ -n "$line" ]]; then
    [[ "$(_macos_brew_service_state_from_line "$line")" == "started" ]]
    return
  fi
  [[ -f "$HOME/Library/LaunchAgents/homebrew.mxcl.$service.plist" ]] && pgrep -x "$service" >/dev/null 2>&1
}

_macos_brew_service_line() {
  local service="$1"
  command -v brew >/dev/null 2>&1 || return 0
  brew services list 2>/dev/null | awk -v service="$service" '$1 == service { print; found = 1 } END { exit found ? 0 : 1 }' || true
}

_macos_brew_service_state_from_line() {
  local line="$1" _name state _rest
  read -r _name state _rest <<<"$line"
  printf '%s\n' "$state"
}

_macos_brew_service_error_log() {
  case "$1" in
    borders) printf '%s\n' /opt/homebrew/var/log/borders/borders.err.log ;;
    *) return 1 ;;
  esac
}

_macos_brew_service_log_hint() {
  local service="$1" line log
  line="$(_macos_brew_service_line "$service")"
  [[ -z "$line" ]] || warn "brew services state: $line"
  log="$(_macos_brew_service_error_log "$service" || true)"
  [[ -n "$log" ]] || return 0
  warn "inspect service log: $log"
  if [[ -s "$log" ]]; then
    tail -n 12 "$log" 2>/dev/null | sed 's/^/  /' >&2 || true
  fi
}

_macos_brew_service_doctor() {
  local service="$1" line state
  line="$(_macos_brew_service_line "$service")"
  state="$(_macos_brew_service_state_from_line "$line")"
  if _macos_brew_service_started "$service"; then
    ok "brew service running: $service"
  elif [[ -n "$line" ]]; then
    warn "brew service $service is $state"
    _macos_brew_service_log_hint "$service"
    return 1
  else
    warn "brew service not started: $service"
    _macos_brew_service_log_hint "$service"
    return 1
  fi
}

_macos_aerospace_running() {
  pgrep -x AeroSpace >/dev/null 2>&1
}

_macos_aerospace_config_ambiguous() {
  # -L too: a dangling root symlink still trips AeroSpace's config lookup.
  [[ -e "$HOME/.aerospace.toml" || -L "$HOME/.aerospace.toml" ]] &&
    [[ -e "${XDG_CONFIG_HOME:-$HOME/.config}/aerospace/aerospace.toml" ]]
}

_macos_brew_prefix() {
  brew --prefix 2>/dev/null || printf '/opt/homebrew\n'
}

_macos_brew_prefix_writable() {
  command -v brew >/dev/null 2>&1 || return 0
  [[ -w "$(_macos_brew_prefix)" ]]
}

_macos_user_is_admin() {
  id -Gn 2>/dev/null | tr ' ' '\n' | grep -qx admin
}

_macos_admin_doctor() {
  if _macos_user_is_admin; then
    ok "account is admin (cask installs into /Applications work)"
  else
    warn "account $USER is not admin; cask installs into /Applications will fail ('not in the sudoers file')"
    warn "grant admin from an admin account: System Settings -> Users & Groups -> $USER"
    return 1
  fi
}

_macos_brew_prefix_doctor() {
  if _macos_brew_prefix_writable; then
    ok "Homebrew prefix writable"
  else
    warn "Homebrew prefix $(_macos_brew_prefix) not writable by $USER; installs will fail until one of:"
    warn "  single-account Mac: sudo chown -R $USER $(_macos_brew_prefix)"
    warn "  shared Mac: sudo chgrp -R admin $(_macos_brew_prefix) && sudo chmod -R g+w $(_macos_brew_prefix)"
    return 1
  fi
}

_macos_aerospace_doctor() {
  local err
  if _macos_aerospace_running; then
    if _macos_aerospace_responding; then
      ok "AeroSpace running and responding"
    else
      err="$(_macos_aerospace_cli_error)"
      warn "AeroSpace running but CLI checks failed${err:+: $err}"
      if _macos_aerospace_config_ambiguous; then
        warn "AeroSpace config exists in both ~/.aerospace.toml and ~/.config/aerospace/; run dotfiles update to clean up"
      fi
      warn "if this mentions permissions: System Settings -> Privacy & Security -> Accessibility"
      return 1
    fi
  else
    warn "AeroSpace not running; run dotfiles update or open /Applications/AeroSpace.app"
    warn "then verify: System Settings -> Privacy & Security -> Accessibility"
    return 1
  fi
}

_macos_aerospace_status() {
  if _macos_aerospace_running; then
    if _macos_aerospace_responding; then
      printf '  aerospace: running/responding\n'
    else
      printf '  aerospace: running, CLI check failed (%s)\n' "$(_macos_aerospace_cli_error)"
    fi
  elif [[ -d /Applications/AeroSpace.app ]]; then
    printf '  aerospace: installed, not running\n'
  else
    printf '  aerospace: missing\n'
  fi
}

# Verify the installed files rather than trusting only the Homebrew cask receipt.
_macos_nerd_font_doctor() {
  local f
  for f in "$HOME/Library/Fonts"/JetBrainsMonoNerdFont*.ttf /Library/Fonts/JetBrainsMonoNerdFont*.ttf; do
    if [[ -f "$f" ]]; then
      ok "JetBrainsMono Nerd Font installed"
      return 0
    fi
  done
  warn "JetBrainsMono Nerd Font files missing; run: brew reinstall --cask font-jetbrains-mono-nerd-font"
  return 1
}

_macos_rectangle_doctor() {
  [[ -d /Applications/Rectangle.app ]] || return 0
  if defaults read com.knollsoft.Rectangle alternateDefaultShortcuts >/dev/null 2>&1; then
    ok "Rectangle shortcuts initialized"
  else
    warn "Rectangle shortcuts not initialized; run dotfiles update"
    return 1
  fi
}

_macos_rectangle_status() {
  local v
  [[ -d /Applications/Rectangle.app ]] || return 0
  v="$(defaults read com.knollsoft.Rectangle alternateDefaultShortcuts 2>/dev/null || printf 'unset')"
  case "$v" in
    1) printf '  rectangle shortcuts: recommended set\n' ;;
    0) printf '  rectangle shortcuts: spectacle-style set\n' ;;
    *) printf '  rectangle shortcuts: unset (run dotfiles update)\n' ;;
  esac
}

_macos_dock_defaults_match() {
  [[ "$(defaults read com.apple.dock autohide 2>/dev/null || true)" == "1" ]] || return 1
  [[ "$(defaults read com.apple.dock orientation 2>/dev/null || true)" == "bottom" ]] || return 1
  [[ "$(defaults read com.apple.dock tilesize 2>/dev/null || true)" == "47" ]] || return 1
  [[ "$(defaults read com.apple.dock show-recents 2>/dev/null || true)" == "0" ]] || return 1
  [[ "$(defaults read com.apple.WindowManager EnableStandardClickToShowDesktop 2>/dev/null || true)" == "0" ]]
}

_macos_dock_doctor() {
  if _macos_dock_defaults_match; then
    ok "Dock and desktop defaults applied"
  else
    warn "Dock defaults not applied; run dotfiles update"
    return 1
  fi
}

_macos_dock_status() {
  printf '  dock autohide: %s\n' "$(defaults read com.apple.dock autohide 2>/dev/null || printf 'unset')"
  printf '  dock orientation: %s\n' "$(defaults read com.apple.dock orientation 2>/dev/null || printf 'unset')"
  printf '  dock tilesize: %s\n' "$(defaults read com.apple.dock tilesize 2>/dev/null || printf 'unset')"
  printf '  dock show recents: %s\n' "$(defaults read com.apple.dock show-recents 2>/dev/null || printf 'unset')"
  printf '  click wallpaper reveals desktop: %s\n' "$(defaults read com.apple.WindowManager EnableStandardClickToShowDesktop 2>/dev/null || printf 'unset')"
}

_macos_finder_defaults_match() {
  [[ "$(defaults read com.apple.finder NewWindowTarget 2>/dev/null || true)" == "PfHm" ]] || return 1
  [[ "$(defaults read com.apple.finder NewWindowTargetPath 2>/dev/null || true)" == "file://$HOME/" ]] || return 1
  [[ "$(defaults read com.apple.finder FXPreferredViewStyle 2>/dev/null || true)" == "clmv" ]] || return 1
  [[ "$(defaults read com.apple.finder ShowPathbar 2>/dev/null || true)" == "1" ]] || return 1
  [[ "$(defaults read com.apple.finder ShowStatusBar 2>/dev/null || true)" == "1" ]] || return 1
  [[ "$(defaults read com.apple.finder FXDefaultSearchScope 2>/dev/null || true)" == "SCcf" ]] || return 1
  [[ "$(defaults read com.apple.finder AppleShowAllFiles 2>/dev/null || true)" == "1" ]] || return 1
  [[ "$(defaults read -g AppleShowAllExtensions 2>/dev/null || true)" == "1" ]]
}

_macos_finder_doctor() {
  if _macos_finder_defaults_match; then
    ok "Finder defaults applied"
  else
    warn "Finder defaults not applied; run dotfiles update"
    return 1
  fi
}

_macos_finder_status() {
  printf '  finder new window target: %s\n' "$(defaults read com.apple.finder NewWindowTarget 2>/dev/null || printf 'unset')"
  printf '  finder default view: %s\n' "$(defaults read com.apple.finder FXPreferredViewStyle 2>/dev/null || printf 'unset')"
  printf '  finder path bar: %s\n' "$(defaults read com.apple.finder ShowPathbar 2>/dev/null || printf 'unset')"
  printf '  finder status bar: %s\n' "$(defaults read com.apple.finder ShowStatusBar 2>/dev/null || printf 'unset')"
  printf '  finder search scope: %s\n' "$(defaults read com.apple.finder FXDefaultSearchScope 2>/dev/null || printf 'unset')"
  printf '  finder show hidden files: %s\n' "$(defaults read com.apple.finder AppleShowAllFiles 2>/dev/null || printf 'unset')"
  printf '  finder show extensions: %s\n' "$(defaults read -g AppleShowAllExtensions 2>/dev/null || printf 'unset')"
}

_macos_input_defaults_match() {
  [[ "$(defaults read -g com.apple.swipescrolldirection 2>/dev/null || true)" == "1" ]] || return 1
  [[ "$(defaults read -g KeyRepeat 2>/dev/null || true)" == "2" ]] || return 1
  [[ "$(defaults read -g InitialKeyRepeat 2>/dev/null || true)" == "15" ]] || return 1
  [[ "$(defaults read -g ApplePressAndHoldEnabled 2>/dev/null || true)" == "0" ]]
}

_macos_input_doctor() {
  if _macos_input_defaults_match; then
    ok "macOS input defaults applied"
  else
    warn "macOS input defaults not applied; run dotfiles update"
    return 1
  fi
}

_macos_input_status() {
  printf '  natural scrolling (trackpad): %s\n' "$(defaults read -g com.apple.swipescrolldirection 2>/dev/null || printf 'unset')"
  if pgrep -x LinearMouse >/dev/null 2>&1; then
    printf '  mouse scroll flip (LinearMouse): running\n'
  else
    printf '  mouse scroll flip (LinearMouse): not running\n'
  fi
  printf '  raycast hotkey: %s\n' "$(defaults read com.raycast.macos raycastGlobalHotkey 2>/dev/null || printf 'unset')"
  printf '  key repeat: %s\n' "$(defaults read -g KeyRepeat 2>/dev/null || printf 'unset')"
  printf '  initial key repeat: %s\n' "$(defaults read -g InitialKeyRepeat 2>/dev/null || printf 'unset')"
  printf '  press-and-hold accents: %s\n' "$(defaults read -g ApplePressAndHoldEnabled 2>/dev/null || printf 'unset')"
}

_macos_wallpaper_launchagent_loaded() {
  local uid
  uid="$(id -u)"
  launchctl print "gui/$uid/com.dotfiles.wallpaper" >/dev/null 2>&1
}

_macos_wallpaper_launchagent_doctor() {
  local exit_code
  if ! _macos_wallpaper_launchagent_loaded; then
    warn "macOS wallpaper LaunchAgent not loaded; run dotfiles update"
    if _macos_dotfiles_launchagent_background_blocked wallpaper; then
      _macos_dotfiles_launchagent_background_hint wallpaper
    fi
    return 1
  fi
  # Loaded is not healthy: launchd keeps a failing job loaded (e.g. exit 78
  # when it cannot open its log paths), so surface the last exit code.
  exit_code="$(launchctl print "gui/$(id -u)/com.dotfiles.wallpaper" 2>/dev/null | awk -F' = ' '/last exit code/ { print $2; exit }')"
  case "$exit_code" in
    ""|0|"(never exited)")
      ok "macOS wallpaper LaunchAgent loaded"
      if _macos_dotfiles_launchagent_background_blocked wallpaper; then
        _macos_dotfiles_launchagent_background_hint wallpaper
        return 1
      fi
      ;;
    *)
      warn "macOS wallpaper LaunchAgent failing (last exit code = $exit_code)"
      warn "inspect: $HOME/Library/Logs/dotfiles/wallpaper.err.log"
      return 1
      ;;
  esac
}

_macos_brew_service_status() {
  local service="$1" line
  if ! command -v brew >/dev/null 2>&1; then
    printf '  %s: unknown (brew missing)\n' "$service"
    return 0
  fi
  line="$(_macos_brew_service_line "$service")"
  if [[ -n "$line" ]]; then
    printf '  %s\n' "$line"
    if [[ "$(_macos_brew_service_state_from_line "$line")" == error* ]]; then
      printf '  %s log: %s\n' "$service" "$(_macos_brew_service_error_log "$service" || true)"
    fi
  elif [[ -f "$HOME/Library/LaunchAgents/homebrew.mxcl.$service.plist" ]] && pgrep -x "$service" >/dev/null 2>&1; then
    printf '  %s: started (LaunchAgent/process)\n' "$service"
  elif [[ -f "$HOME/Library/LaunchAgents/homebrew.mxcl.$service.plist" ]]; then
    printf '  %s: LaunchAgent present, process not running\n' "$service"
  else
    printf '  %s: not registered with brew services\n' "$service"
  fi
}

_macos_app_status() {
  local name="$1" path="$2"
  if [[ -d "$path" ]]; then
    printf '  %s: installed\n' "$name"
  else
    printf '  %s: missing\n' "$name"
  fi
}

_omarchy_shell_status() {
  if pgrep -x quickshell >/dev/null 2>&1; then
    printf '  omarchy shell: running (quickshell)\n'
    return 0
  fi
  printf '  omarchy shell: not running\n'
}

_waybar_status() {
  if pgrep -x waybar >/dev/null 2>&1; then
    printf '  waybar: running (process)\n'
    return 0
  fi
  if command -v systemctl >/dev/null 2>&1 && systemctl --user list-unit-files waybar.service --no-legend 2>/dev/null | grep -q '^waybar\.service'; then
    if systemctl --user is-active --quiet waybar.service 2>/dev/null; then
      printf '  waybar: running (systemd user service)\n'
    else
      printf '  waybar: not running (systemd user service inactive)\n'
    fi
  else
    printf '  waybar: not running (no systemd user service detected; Omarchy may launch it as a process)\n'
  fi
}

expected_hypr_active_border() {
  local file="$DOTFILES_DIR/stow/os-omarchy/hyprland/.config/hypr/conf.d/99-personal.conf"
  sed -n 's/^[[:space:]]*col\.active_border[[:space:]]*=[[:space:]]*//p' "$file" 2>/dev/null | tail -n 1
}

check_hypr_active_border() {
  local expected live live_lower expected_hex
  expected="$(expected_hypr_active_border)"
  expected_hex="$(printf '%s\n' "$expected" | tr '[:upper:]' '[:lower:]' | sed -n 's/.*rgba(\([0-9a-f]\{6,8\}\)).*/\1/p')"
  live="$(hyprctl getoption general:col.active_border 2>/dev/null || true)"
  live_lower="$(printf '%s\n' "$live" | tr '[:upper:]' '[:lower:]')"
  if [[ -n "$expected_hex" && "$live_lower" == *"$expected_hex"* ]]; then
    ok "active border color matches expected green ($expected)"
    return 0
  fi
  warn "active border color mismatch"
  printf '  expected: %s\n' "${expected:-unknown}"
  printf '  live    : %s\n' "${live:-unavailable}"
  return 1
}

# _status_line <label> <test-cmd> <ok-text> <bad-text>
_status_line() {
  local label="$1" test="$2" good="$3" bad="$4"
  if ! command -v "$label" >/dev/null 2>&1; then
    dim "  $label: not installed"
  elif eval "$test"; then
    printf '  %s: %s\n' "$label" "$good"
  else
    printf '  %s: %s\n' "$label" "$bad"
  fi
}

_mtime() {
  if [[ "$(uname -s)" == "Darwin" ]]; then
    stat -f %m "$1"
  else
    stat -c %Y "$1"
  fi
}

# Installed formulae+casks, fetched once per run. Plain `brew list` avoids
# loading package definitions, so Homebrew 6 tap-trust checks cannot error,
# and 2 brew calls beat 2 calls per declared package.
_brew_installed_names=""
_brew_pkg_installed() {
  local short="${1##*/}"  # tap-qualified names install as their short name
  command -v brew >/dev/null 2>&1 || return 1
  if [[ -z "$_brew_installed_names" ]]; then
    _brew_installed_names="$(brew list --formula 2>/dev/null; brew list --cask 2>/dev/null)"
  fi
  grep -Fxq "$short" <<<"$_brew_installed_names"
}

_pkg_installed() {
  case "$(detect_os)" in
    omarchy) pacman -Qq "$1" >/dev/null 2>&1 ;;
    debian|ubuntu) dpkg -s "$1" >/dev/null 2>&1 ;;
    macos) _brew_pkg_installed "$1" ;;
    *) return 0 ;;
  esac
}

main() {
  local cmd="${1:-status}"; shift || true
  case "$cmd" in
    status) cmd_status "$@" ;;
    update) cmd_update "$@" ;;
    apply)  cmd_apply "$@" ;;
    doctor) cmd_doctor "$@" ;;
    commands) cmd_commands "$@" ;;
    wallpaper) cmd_wallpaper "$@" ;;
    screen) cmd_screen "$@" ;;
    oled) cmd_oled "$@" ;;
    away) cmd_away "$@" ;;
    llm) cmd_llm "$@" ;;
    tailscale-policy) cmd_tailscale_policy "$@" ;;
    recovery) cmd_recovery "$@" ;;
    git) cmd_git "$@" ;;
    autostart) cmd_autostart "$@" ;;
    help|-h|--help) usage ;;
    *) err "unknown command: $cmd"; usage; exit 1 ;;
  esac
}

main "$@"
